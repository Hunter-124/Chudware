# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv-mcp/
.pip-cache/
.deps/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local configuration
.env
config.json

# OS / editor / tool state
.DS_Store
.idea/
.cache/
.omp/
imgui.ini

# C++ build trees (host/build-linux, core/build-linux, core/build-occt-linux, ...)
host/build*/
core/build*/
# CMake preset build dirs (build/<preset>)
/build/
# clangd compilation database / convenience symlink
/compile_commands.json

# Release artifacts (regenerate with services/installer/build_release.py)
dist/

# Fetched third-party SDKs and prebuilt binaries (provisioned by CMake / fetch scripts)
third_party/
OCCT/
extern/cef/

# Node
node_modules/

# PLM vault and agent memory created when the repo root is opened as a project
/.aicadvault/
.plm/

# Per-machine MCP client configs (absolute paths); regenerate with
# services/installer/setup_mcp_clients.py (Windows: mcp_setup.bat)
/.mcp.json
/opencode.json
/.cursor/mcp.json
/.cursor/mcp.json.disabled
/.vscode/mcp.json
/.grok/
*.chudware-bak

# Scratch and runtime output
scratch/
/preflight_events.jsonl
/runs/
/reports/
/*.step+
benchmarks/simsuite/results/
tools/flywheel/bench/gym/reports/
# Machine-local performance baseline written by tools/perf_regression.py
tools/perf_baseline.json

# Exported CAD files (regenerate via export)
*.step
*.stp

# Promotional website (Astro): source, public/ and package-lock.json are tracked
website/node_modules/
website/dist/
website/.astro/
website/.wrangler/

# Web deployment credentials and per-deployment env files
web/Cloudflare-info.txt
web/secrets/
web/gateway/.venv/
web/**/*.env
!web/gateway/config.example.env
