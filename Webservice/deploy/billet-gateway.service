[Unit]
Description=billet-web gateway (FastAPI / uvicorn on 127.0.0.1:8300)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Repositories/CAD/Webservice/gateway
EnvironmentFile=-%h/billet-web-data/gateway.env
EnvironmentFile=-%h/billet-web/webd.env
Environment=BILLET_WEB_DATA=%h/billet-web-data
# venv + uvicorn; app module owned by GatewayCore
ExecStart=%h/Repositories/CAD/Webservice/gateway/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8300 --proxy-headers --forwarded-allow-ips=127.0.0.1 --ws-max-size 268435456
Restart=on-failure
RestartSec=3
MemoryMax=1G
# Soft guard so the unit dies cleanly before the OOM killer thrash
MemoryHigh=900M
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=default.target
