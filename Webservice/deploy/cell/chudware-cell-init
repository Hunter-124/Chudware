#!/usr/bin/python3 -IS
import os
from pathlib import Path
import signal
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from cell_runtime import close_extra_fds
from cell_forwarder import start

if __name__ == "__main__":
    try:
        if len(sys.argv) != 1:
            raise ValueError("cell initializer takes no arguments")
        close_extra_fds((3,))
        listeners = start()
        child = subprocess.Popen(["/opt/chudware/bin/chudware-hostd", "--cell",
            "--gateway-listen-fd", "3", "--cell-state", "/state", "--cell-work", "/work"],
            pass_fds=(3,), close_fds=True)
        os.close(3)
        def stop(signum, frame):
            if child.poll() is None:
                child.send_signal(signum)
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        status = child.wait()  # no cell/agent wall-clock cap
        for listener in listeners:
            listener.close()
        sys.exit(status if status >= 0 else 128 - status)
    except Exception as exc:
        print("cell_refused: " + str(exc), file=sys.stderr)
        sys.exit(1)
