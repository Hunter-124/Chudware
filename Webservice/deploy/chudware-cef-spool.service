[Unit]
Description=Bound the Chudware CEF Chromium metrics spool
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/Repositories/CAD/Webservice/deploy/cef_spool_reaper.py
# Stdlib only, deliberately: this must keep working when the gateway venv is
# mid-reinstall, because the disk it protects is the one the venv lives on.
Nice=15
IOSchedulingClass=idle
