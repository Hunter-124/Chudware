[Unit]
Description=chudware-web cloudflared tunnel (token from protected environment)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/chudware-web-data/cloudflared.env
# cloudflared reads TUNNEL_TOKEN directly from the environment; never expand it
# into ExecStart, where every local user can read it through /proc or ps.
ExecStart=/usr/local/bin/cloudflared tunnel run
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
