[Unit]
Description=chudware-web gateway (FastAPI / uvicorn on 127.0.0.1:8300)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Repositories/CAD/Webservice/gateway
EnvironmentFile=-%h/chudware-web-data/gateway.env
EnvironmentFile=-%h/chudware-web/webd.env
Environment=CHUDWARE_WEB_DATA=%h/chudware-web-data
# systemd decrypts this into a private runtime credential directory. The key
# never enters gateway.env, the database, the repository, or /proc environ.
LoadCredentialEncrypted=entitlement.key:%h/.config/credstore.encrypted/chudware-entitlement.cred
Environment=CHUDWARE_ENTITLEMENT_KEY_PATH=%d/entitlement.key
# Keep uvicorn's WebSocket frame ceiling identical to the gateway forwarding
# budget. EnvironmentFile overrides this default when the operator tunes it.
Environment=CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304
# Production-like units must never enable the local authentication bypass.
ExecStartPre=/usr/bin/bash -c 'case "${CHUDWARE_WEB_DEV:-}" in ""|0|false|False|FALSE|no|No|NO|off|Off|OFF) exit 0;; *) echo "ERROR: CHUDWARE_WEB_DEV must be disabled in production" >&2; exit 1;; esac'
# venv + uvicorn; app module owned by GatewayCore
ExecStart=%h/Repositories/CAD/Webservice/gateway/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8300 --proxy-headers --forwarded-allow-ips=127.0.0.1 --ws-max-size ${CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES} --no-access-log
Restart=on-failure
RestartSec=3
MemoryMax=1G
# Soft guard so the unit dies cleanly before the OOM killer thrash
MemoryHigh=900M
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# The gateway has four explicit writable roots under ProtectHome=read-only:
# - chudware-web-data: database/config/runtime data
# - chudware-web: staged web daemon data
# - ME489: per-identity bucket roots
# - chudware-releases: signed release staging (`incoming/`) and published installers
#
# Omitting the release root made `/api/releases/ci/upload/*` fail with EROFS even though
# Unix ownership/mode were correct, so a multi-hour nightly build could never publish.
ReadWritePaths=%h/chudware-web-data %h/chudware-web %h/ME489 %h/chudware-releases
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077


[Install]
WantedBy=default.target
