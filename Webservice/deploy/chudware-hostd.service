# chudware-hostd — the SHARED Chudware engine daemon serving web + local + agent
# clients (one live session for everyone). Installed/templated by
# install_webd.sh (@BIN@ -> ~/chudware-web/bin); do not edit the installed copy.
[Unit]
Description=Chudware shared web engine daemon (chudware-webd)
After=default.target

[Service]
Type=simple
ExecStart=@BIN@/chudware-hostd --foreground
# Verbatim instance key: socket = $XDG_RUNTIME_DIR/chudware/hostd-chudwareweb.sock,
# never shared with dev daemons (those key on binary realpath).
Environment=CHUDWARE_INSTANCE_KEY=chudwareweb
# A shared team daemon must not self-exit between working sessions.
Environment=CHUDWARE_HOSTD_LINGER_SECS=86400
# The C++ agent (agent_run_v2) reads its role prompts (intake/decomposer/executor/...)
# from CHUDWARE_PROMPTS_DIR; without it the daemon resolves the relative "agent/prompts"
# against its CWD (none here) and every agent run throws "role prompt unreadable/empty".
# install_webd.sh deploys the prompt tree to @PROMPTS@ and stamps this path.
Environment=CHUDWARE_PROMPTS_DIR=@PROMPTS@
# Python worker bridge (hostd/worker_bridge.cpp): engine-unknown methods
# (plm_*, git_*, ai_roles_*, provider accounts — the whole PLM + Settings
# surface) are forwarded to a lazily-spawned `python -m services.worker_main`
# subprocess. CHUDWARE_PYTHON, if set, is used verbatim with NO fallback —
# worker_bridge.cpp's built-in logic (try the Chudware runtime venv, else
# fall back to a system python3) only runs when this var is UNSET. Do not
# stamp it here "for documentation": that pins every host to a runtime venv
# that install_webd.sh never provisions, hard-failing subscription/provider
# RPCs with "Python runtime not found" the moment someone actually reads
# this comment and takes it literally. Leave unset; CHUDWARE_REPO still
# needs stamping so `import services` resolves without a source-tree CWD.
Environment=CHUDWARE_REPO=%h/Repositories/CAD
# always — shared webd must come back after clean exits too (binary replace
# during install_webd without --restart, unexpected idle-exit, etc.). systemctl
# stop still stays down; only unexpected death auto-recovers.
Restart=always
RestartSec=2
# Final autosave on stop needs a moment on big docs.
TimeoutStopSec=30

[Install]
WantedBy=default.target
