[Unit]
Description=chudware-web superseded release artifact retention
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/chudware-web-data/gateway.env
WorkingDirectory=%h/Repositories/CAD/Webservice/gateway
ExecStart=%h/Repositories/CAD/Webservice/gateway/.venv/bin/python %h/Repositories/CAD/Webservice/deploy/release_retention.py
Nice=15
IOSchedulingClass=idle
