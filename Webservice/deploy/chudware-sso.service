[Unit]
Description=chudware-web Microsoft Entra SSO front door (oauth2-proxy on sso.chudware.com)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network-online.target chudware-gateway.service
Wants=network-online.target
Requires=chudware-gateway.service

[Service]
Type=simple
ExecStart=%h/.local/bin/oauth2-proxy --config=%h/chudware-web-data/oauth2-proxy.cfg
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
