[Unit]
Description=Chudware University of Alabama live Box workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
UMask=0077
Environment=RCLONE_CONFIG=%h/chudware-web-data/university/secrets/rclone.conf
ExecStart=%h/chudware-web-data/university/bin/rclone mount box: %h/chudware-web-data/university/ME-490 --vfs-cache-mode full --cache-dir %h/chudware-web-data/university/cache --vfs-cache-max-size 12G --vfs-cache-min-free-space 8G --vfs-write-back 5s --dir-cache-time 1h --poll-interval 5s --vfs-refresh --attr-timeout 1s --umask 077 --log-level NOTICE --rc --rc-addr unix://%h/chudware-web-data/university/secrets/rc.sock --rc-no-auth
ExecStop=/usr/bin/fusermount3 -u %h/chudware-web-data/university/ME-490
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=default.target
