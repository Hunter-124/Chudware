# chudware-webd-sync.path — re-promote the shared web daemon when the engine
# build tree produces a new chudware-hostd binary.
[Unit]
Description=Watch chudware-hostd build output and re-install chudware-webd

[Path]
PathChanged=%h/Repositories/CAD/core/build-occt-linux/bin/chudware-hostd
Unit=chudware-webd-sync.service

[Install]
WantedBy=default.target
