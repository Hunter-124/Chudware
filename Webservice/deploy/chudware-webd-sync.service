# chudware-webd-sync.service — triggered by chudware-webd-sync.path after a
# full-engine hostd build. install_webd stages and validates that exact engine
# tree with a fresh WASM bundle before promotion. If authenticated gateway
# telemetry is unavailable or engine bridges remain active, it fails closed
# without promoting or restarting the shared daemon.
[Unit]
Description=Validate and promote a joint chudware-webd release after engine rebuild

[Service]
Type=oneshot
Environment=CHUDWARE_WEBD_ARTIFACT_DIR=%h/Repositories/CAD/core/build-occt-linux/bin
ExecStartPre=/bin/sleep 10
ExecStart=%h/Repositories/CAD/Webservice/deploy/install_webd.sh --restart
# The oneshot may spend time building WASM and then wait up to 600 seconds for
# active engine bridges to drain. At the deadline it fails rather than dropping
# users, so leave enough room for both phases.
TimeoutStartSec=1800
