# oauth2-proxy config template for the Microsoft Entra (UA school Microsoft/Outlook/
# Teams accounts) sign-in front door at https://sso.chudware.com.
#
# Copy to ~/chudware-web-data/oauth2-proxy.cfg (chmod 600) and fill in the
# REPLACE_ME values. NEVER commit the filled-in copy — it holds real secrets.
#
# Why this exists: Cloudflare Access's built-in Entra IdP is scoped to ONE Entra
# tenant (needs a Directory/tenant ID) — it cannot do "any Microsoft work account"
# the way Google is universal. UA students can't self-register/admin-consent an app
# in the ua.edu tenant. oauth2-proxy's entra-id provider supports the multi-tenant
# /common endpoint instead, so this runs as a second, independent front door
# alongside (not replacing) the existing Cloudflare Access app on chudware.com.
#
# Topology: browser -> Cloudflare Tunnel -> sso.chudware.com -> oauth2-proxy (here,
# 127.0.0.1:8301) -> verifies Entra login -> reverse-proxies to the real gateway at
# 127.0.0.1:8300, with HTTP Basic Auth (username=verified email, password=shared
# secret) so gateway/auth.py can trust the identity without re-doing OIDC itself.
# See gateway/auth.py's AuthMiddleware._authenticate SSO branch.
#
# Registering the Azure app (RUNBOOK.md §Entra SSO has the full walkthrough):
#   1. portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration.
#   2. Supported account types: "Accounts in any organizational directory
#      (Any Microsoft Entra ID tenant - Multitenant)". Do NOT add personal
#      Microsoft accounts unless you also want consumer @outlook.com logins.
#   3. Redirect URI (Web): https://sso.chudware.com/oauth2/callback
#   4. Certificates & secrets -> New client secret -> copy the Value immediately.
#   5. API permissions -> Microsoft Graph -> Delegated -> openid, profile, email,
#      offline_access, User.Read. Stay OFF Directory.Read.All/GroupMember.Read.All
#      (those force admin consent per-tenant and will wall out students whose UA IT
#      hasn't approved this app — see research/auth.md).
#   6. Copy Application (client) ID + the client secret Value below.

provider = "entra-id"
oidc_issuer_url = "https://login.microsoftonline.com/common/v2.0"
insecure_oidc_skip_issuer_verification = true
insecure_oidc_skip_nonce = true
scope = "openid profile email"

client_id = "REPLACE_WITH_AZURE_APP_CLIENT_ID"
client_secret = "REPLACE_WITH_AZURE_APP_CLIENT_SECRET"
redirect_url = "https://sso.chudware.com/oauth2/callback"

# Only UA people can even complete login here; the gateway's own AUTO_APPROVE_DOMAINS
# / users.yaml allowlist is enforced again downstream (defense in depth).
email_domains = ["ua.edu", "crimson.ua.edu"]

http_address = "127.0.0.1:8301"
upstreams = ["http://127.0.0.1:8300/"]
reverse_proxy = true
real_client_ip_header = "CF-Connecting-IP"
skip_provider_button = true

# Generate: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
cookie_secret = "REPLACE_WITH_GENERATED_COOKIE_SECRET"
cookie_secure = true
cookie_samesite = "lax"

# Identity handoff to the gateway (see gateway/auth.py SSO branch): Basic Auth
# username = verified email, password = shared secret below. Must match
# CHUDWARE_WEB_SSO_SHARED_SECRET in gateway.env exactly.
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
pass_basic_auth = true
prefer_email_to_user = true
basic_auth_password = "REPLACE_WITH_GENERATED_SHARED_SECRET"
pass_access_token = false
pass_authorization_header = false

silence_ping_logging = true
