# billet-web gateway — copy to a gitignored .env / systemd EnvironmentFile
# Prefix: BILLET_WEB_*

BILLET_WEB_DATA_ROOT=~/billet-web-data
BILLET_WEB_HOST=127.0.0.1
BILLET_WEB_PORT=8300

BILLET_WEB_MAX_SESSIONS=3
BILLET_WEB_MAX_HEAVY=2
BILLET_WEB_SESSION_MEMORY=5g
BILLET_WEB_SESSION_CPUS=2
BILLET_WEB_SESSION_PIDS=2048
BILLET_WEB_IDLE_TIMEOUT_SEC=1800
BILLET_WEB_MIN_HOST_RAM_GIB=8
BILLET_WEB_STREAM_PORT_BASE=8400

BILLET_WEB_SESSION_IMAGE=localhost/billet-session:latest
BILLET_WEB_STREAM_BACKEND=selkies

# Cloudflare Access (prod). Team domain is the issuer base (no trailing slash).
BILLET_WEB_CF_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
BILLET_WEB_CF_AUD=YOUR_APPLICATION_AUD_TAG

# Local testing only — accepts X-Dev-User: you@example.com (must be in users.yaml)
BILLET_WEB_DEV=0

# Optional override for allowlist path
# BILLET_WEB_USERS_FILE=/path/to/users.yaml
