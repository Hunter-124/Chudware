# chudware-web gateway — copy to a gitignored .env / systemd EnvironmentFile
# Prefix: CHUDWARE_WEB_* for gateway settings; CHUDWARE_DB_* for the store;
# CHUDWARE_MAIL_*, CHUDWARE_SMTP_* and CHUDWARE_RESEND_* for outbound mail.

CHUDWARE_WEB_DATA_ROOT=~/chudware-web-data
CHUDWARE_WEB_HOST=127.0.0.1
CHUDWARE_WEB_PORT=8300

# --- Store (PostgreSQL) -------------------------------------------------------
# REQUIRED. The gateway opens the pool and applies migrations/*.sql at startup,
# and REFUSES TO BOOT if either fails — a gateway answering requests against a
# missing or half-migrated schema looks healthy and answers wrongly. Read from
# the raw environment rather than a CHUDWARE_WEB_* setting because the pool has
# to exist before anything else is wired up.
CHUDWARE_DB_URL=postgresql://chudware_prod:CHANGEME@127.0.0.1:5432/chudware_prod
# Pool ceiling and the seconds we wait before declaring the store unreachable.
# CHUDWARE_DB_POOL_MAX=10
# CHUDWARE_DB_CONNECT_TIMEOUT=10
# CHUDWARE_DB_TIMEOUT=10

# --- Self-serve authentication ----------------------------------------------
# REQUIRED unless Cloudflare Access is configured below: the gateway refuses to
# boot without at least one strong auth path. Signs the single-use OAuth state
# parameter. Generate with:  python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
CHUDWARE_WEB_SESSION_SECRET=
# Absolute session expiry. last_seen_at slides inside the window; this does not.
CHUDWARE_WEB_SESSION_TTL_DAYS=30
# Free trial granted when a registrant clicks their verification link.
CHUDWARE_WEB_TRIAL_DAYS=14
# Origin used to build verification, password-reset, and OAuth redirect URLs.
# NOT derived from the Host header — a link built from an attacker-supplied
# host is a credential-delivery vulnerability.
CHUDWARE_WEB_PUBLIC_BASE_URL=https://chudware.com

# Optional social sign-in. Setting any PAIR requires SESSION_SECRET above.
# Google redirect URI:     <PUBLIC_BASE_URL>/api/auth/oauth/google/callback
# GitHub redirect URI:     <PUBLIC_BASE_URL>/api/auth/oauth/github/callback
# Microsoft redirect URI:  <PUBLIC_BASE_URL>/api/auth/oauth/microsoft/callback
# CHUDWARE_WEB_GOOGLE_CLIENT_ID=
# CHUDWARE_WEB_GOOGLE_CLIENT_SECRET=
# CHUDWARE_WEB_GITHUB_CLIENT_ID=
# CHUDWARE_WEB_GITHUB_CLIENT_SECRET=
# Microsoft (Entra ID). TENANT is part of every endpoint URL and defaults to
# "common" (work/school and personal accounts); "organizations" is work/school
# only, and a tenant id or verified domain locks sign-in to one directory.
# The app registration MUST emit the optional id_token claims "email" AND
# "xms_edov" (email domain owner verified) — without xms_edov proving the
# tenant owns the address, Microsoft sign-in is refused rather than trusted,
# because an unverified tenant-set email is the nOAuth takeover vector.
# CHUDWARE_WEB_MICROSOFT_CLIENT_ID=
# CHUDWARE_WEB_MICROSOFT_CLIENT_SECRET=
# CHUDWARE_WEB_MICROSOFT_TENANT=common

# Cloudflare Access — the OPERATOR door, scoped to /admin. Not the front door:
# ordinary users register above. Team domain is the issuer base (no trailing slash).
CHUDWARE_WEB_CF_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CHUDWARE_WEB_CF_AUD=YOUR_APPLICATION_AUD_TAG

# Local testing only — accepts X-Dev-User: you@example.com
CHUDWARE_WEB_DEV=0

# --- Per-account limits (multi-tenant hardening) ----------------------------
# Early wire-byte and streaming caps apply before request parsing, including
# bodies without Content-Length. JSON/auth and security compressed bodies:
# 64 KiB; billing webhooks: 1 MiB; workspace chat: 5 MiB.
# Workspace/bucket uploads use MAX_UPLOAD_BYTES below. Studio assets use their
# per-asset setting plus 64 KiB multipart overhead. Release CI/admin uploads:
# 2 GiB, plus 64 KiB multipart overhead for admin uploads.
# Max file bytes for a single workspace/bucket upload:
CHUDWARE_WEB_MAX_UPLOAD_BYTES=104857600
# Max websocket message size in bytes; larger frames are dropped before any
# forwarding (protects the 1 GiB gateway from OOM).
CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304

# --- Rate limits (per authenticated account) ---------------------------------
CHUDWARE_WEB_RATE_WRITES_PER_MIN=120          # mutating API calls / minute
CHUDWARE_WEB_RATE_UPLOADS_PER_MIN=30          # file uploads / minute
CHUDWARE_WEB_RATE_CHAT_PER_MIN=20             # chat messages / minute

# --- Transactional mail ------------------------------------------------------
# READ THIS ON A FRESH DEPLOY: the default backend is `console`, which only
# writes the rendered message to the gateway log. Verification links, password
# resets and dunning notices are queued and "delivered" to journalctl — the
# gateway looks perfectly healthy and no customer ever receives anything. Set
# CHUDWARE_MAIL_BACKEND to resend or smtp before taking signups.
#   console  log only (default; dev boxes and the test suite)
#   resend   HTTPS POST to api.resend.com; needs CHUDWARE_RESEND_API_KEY
#   smtp     any relay (Amazon SES above Resend's 100/day free tier)
# A backend named without its credential refuses to boot rather than queue
# mail that can never leave.
CHUDWARE_MAIL_BACKEND=console
# REQUIRED in every mode: independent URL-safe base64 encoding of 32 random bytes.
# Encrypts queued mail context; retain with database backups. No session-key fallback.
CHUDWARE_MAIL_CONTEXT_ENCRYPTION_KEY=
# Envelope sender. Must be on a domain verified with the chosen provider, or
# every message is rejected or spam-filed. Default: Chudware <noreply@chudware.com>
# QUOTED ON PURPOSE: systemd EnvironmentFile strips the quotes, but the runbook
# also sources this file with `set -a; . gateway.env` — and unquoted `<`/`>` are
# shell redirections, so bare Chudware <noreply@…> aborts the whole source with a
# syntax error and every later variable silently goes unset.
CHUDWARE_MAIL_FROM="Chudware <noreply@chudware.com>"
# Required when CHUDWARE_MAIL_BACKEND=resend. No default.
# CHUDWARE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Required when CHUDWARE_MAIL_BACKEND=smtp. Host has no default; port defaults
# to 587. Leave USER empty for an unauthenticated relay.
# CHUDWARE_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# CHUDWARE_SMTP_PORT=587
# CHUDWARE_SMTP_USER=
# CHUDWARE_SMTP_PASS=
# How the submission session is encrypted. There is no plaintext option.
#   starttls  (default) upgrade in-band; the relay MUST advertise STARTTLS or
#             delivery fails rather than quietly sending the password in clear
#   implicit  TLS from the first byte, for a submissions port that speaks
#             nothing else (port 465 — this is what Stalwart offers; it refuses
#             587 outright)
# CHUDWARE_SMTP_TLS=starttls
# Outbound mail is capped at 5 messages per canonical recipient per hour:
# addresses are lowercased, +tags removed, and Gmail/googlemail dots unified.
# Destination addresses are not rewritten; aliases only share limiter budget.
# Process-wide hourly reservation cap across ALL templates and recipients.
# Must be positive. Denied recipient sends and transport retries do not spend it.
# Tune to the relay's allowance; the default limits a sudden signup/mail burst
# but is not a substitute for the relay's separate daily quota.
CHUDWARE_MAIL_GLOBAL_PER_HOUR=20

# --- Stripe billing ----------------------------------------------------------
# Entirely optional until a Stripe account exists. Once any subscription
# credential is set, SECRET_KEY, WEBHOOK_SECRET, and all four subscription
# prices are required together; a partial set refuses to boot.
# CHUDWARE_WEB_STRIPE_SECRET_KEY=sk_live_...
# CHUDWARE_WEB_STRIPE_WEBHOOK_SECRET=whsec_...
# CHUDWARE_WEB_STRIPE_SUCCESS_URL=https://app.chudware.com/?billing=success
# CHUDWARE_WEB_STRIPE_CANCEL_URL=https://app.chudware.com/?billing=cancel
# Price IDs emitted by deploy/provision_stripe.py:
# CHUDWARE_STRIPE_PRICE_DESKTOP=price_...
# CHUDWARE_STRIPE_PRICE_DESKTOP_EDU=price_...
# CHUDWARE_STRIPE_PRICE_STUDIO=price_...
# CHUDWARE_STRIPE_PRICE_STUDIO_EDU=price_...
# Customer credit-pack checkout is unfinished and remains disabled independently
# of subscription billing. Keep any legacy price IDs so delayed webhooks and
# historic admin reports can still identify completed sessions.
CHUDWARE_CREDIT_PACK_CHECKOUT_ENABLED=0
# CHUDWARE_STRIPE_PRICE_CREDITS_STARTER=price_...
# CHUDWARE_STRIPE_PRICE_CREDITS_STANDARD=price_...
# CHUDWARE_STRIPE_PRICE_CREDITS_BULK=price_...

# --- Admin browser terminal (interactive shell as the gateway account) -------
# OFF by default — enabling exposes a root-of-the-app shell to admin users.
CHUDWARE_WEB_TERMINAL_ENABLED=0
CHUDWARE_WEB_TERMINAL_MAX_SESSIONS=8
CHUDWARE_WEB_TERMINAL_IDLE_TIMEOUT_SEC=1800

# Colon-separated allowlist of host directories an admin may browse/pick as a
# project root. Empty = home directory only.
# CHUDWARE_WEB_PROJECT_ROOTS=/home/liveuser:/srv/projects

# --- Web-native client (WASM /app + OS-isolated tenant cells) -----------------
# Existing workspace storage can be discovered from the selected webd.env;
# engine endpoints are cell-only, never discovered from a shared daemon.
# CHUDWARE_WORKSPACE_ROOT=/home/liveuser/chudware-workspace
# Max concurrent /engine bridges ONE account may hold open.
CHUDWARE_WEB_MAX_ENGINE_BRIDGES_PER_USER=4
# Tenant cell socket directory (must match cell-runtime.json and installed units).
# CHUDWARE_CELLS_ROOT=/home/liveuser/chudware-web/cells
# Optional institutional default: provision existing verified accounts via
# deploy/provision_university_workspace.py; mount a separately authorized Box
# remote first. These do NOT grant account plans, AI credits or platform roles.
# CHUDWARE_WEB_UNIVERSITY_ORG_ID=<provisioned organization UUID>
# CHUDWARE_WEB_UNIVERSITY_TEAM_ID=<provisioned team UUID>
# CHUDWARE_WEB_UNIVERSITY_WORKSPACE_ROOT=/home/liveuser/chudware-web-data/university/ME-490

# --- Account-scoped AI credential storage ----------------------------------
# Browser turns use account-scoped BYOK in actor-private tenant cells only.
# Connected subscription/pool credentials remain unavailable to cell turns.
# Operator credentials never enter a tenant process.
#
# Per-account credentials (BYOK API keys AND connected Claude / ChatGPT
# subscriptions) are encrypted at rest under this key, so it is REQUIRED for
# either feature. Without it, /api/providers/keys and
# /api/providers/accounts answer 503 "storage is unavailable" and the portal's
# provider UI looks broken while being entirely correct.
#
# Rotating or losing this value does NOT corrupt the tables, but every existing
# row becomes undecryptable and each account must re-enter its key or
# re-connect its subscription. Back it up with the database, not in it.
# Generate with:  python3 -c 'import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip("="))'
CHUDWARE_WEB_PROVIDER_KEY_ENCRYPTION_KEY=

# --- Desktop release distribution --------------------------------------------
# Where signed installers and their evidence sidecars live on this host:
#   <dir>/                  flat manual-upload area the /admin Releases card lists
#   <dir>/incoming/         CI stages artifacts here; NOTHING is ever served from
#                           it — an unverified file under a canonical name is the
#                           artifact-substitution attack the signatures stop
#   <dir>/store/<channel>/<version>/  verified, published bytes
# Default: ~/chudware-releases
# CHUDWARE_RELEASES_DIR=/home/liveuser/chudware-releases
#
# Bearer token for POST /api/releases/ci/publish, /api/releases/ci/status and
# GET /api/releases/ci/builds — the nightly workflow's only credential. Unset,
# those routes answer 503 and no release can ever be published. Generate with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# NEVER commit this, and NEVER let it leave the gateway host: the Windows runner
# reads it over ssh on the box itself rather than holding a copy.
# CHUDWARE_GATEWAY_RELEASE_TOKEN=
#
# Origin the desktop updater is told to download from. NOT derived from the Host
# header — a manifest URL built from an attacker-supplied host redirects every
# update download. Default: https://app.chudware.com
# CHUDWARE_RELEASES_PUBLIC_BASE_URL=https://app.chudware.com
#
# Optional CDN offload. When all three R2_* values are set, /api/releases/latest
# hands out a 15-minute presigned R2 URL instead of this gateway's own
# /api/releases/artifact/<key> route; when any is unset the gateway serves the
# bytes itself. Absence is a supported deployment, not a misconfiguration.
# R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CHUDWARE_RELEASES_BUCKET=chudware-releases
