# chudware-web gateway — copy to a gitignored .env / systemd EnvironmentFile
# Prefix: CHUDWARE_WEB_* for gateway settings; CHUDWARE_DB_* for the store;
# CHUDWARE_MAIL_*, CHUDWARE_SMTP_* and CHUDWARE_RESEND_* for outbound mail.

CHUDWARE_WEB_DATA_ROOT=~/chudware-web-data
CHUDWARE_WEB_HOST=127.0.0.1
CHUDWARE_WEB_PORT=8300

# --- Store (PostgreSQL) -------------------------------------------------------
# REQUIRED. The gateway opens the pool and applies migrations/*.sql at startup,
# and REFUSES TO BOOT if either fails — a gateway answering requests against a
# missing or half-migrated schema looks healthy and answers wrongly. Read from
# the raw environment rather than a CHUDWARE_WEB_* setting because the pool has
# to exist before anything else is wired up.
CHUDWARE_DB_URL=postgresql://chudware_prod:CHANGEME@127.0.0.1:5432/chudware_prod
# Pool ceiling and the seconds we wait before declaring the store unreachable.
# CHUDWARE_DB_POOL_MAX=10
# CHUDWARE_DB_CONNECT_TIMEOUT=10
# CHUDWARE_DB_TIMEOUT=10

# --- Self-serve authentication ----------------------------------------------
# REQUIRED unless Cloudflare Access is configured below: the gateway refuses to
# boot without at least one strong auth path. Signs the single-use OAuth state
# parameter. Generate with:  python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
CHUDWARE_WEB_SESSION_SECRET=
# Absolute session expiry. last_seen_at slides inside the window; this does not.
CHUDWARE_WEB_SESSION_TTL_DAYS=30
# Free trial granted when a registrant clicks their verification link.
CHUDWARE_WEB_TRIAL_DAYS=14
# Origin used to build verification, password-reset, and OAuth redirect URLs.
# NOT derived from the Host header — a link built from an attacker-supplied
# host is a credential-delivery vulnerability.
CHUDWARE_WEB_PUBLIC_BASE_URL=https://chudware.com

# Optional social sign-in. Setting either PAIR requires SESSION_SECRET above.
# Google redirect URI:  <PUBLIC_BASE_URL>/api/auth/oauth/google/callback
# GitHub redirect URI:  <PUBLIC_BASE_URL>/api/auth/oauth/github/callback
# CHUDWARE_WEB_GOOGLE_CLIENT_ID=
# CHUDWARE_WEB_GOOGLE_CLIENT_SECRET=
# CHUDWARE_WEB_GITHUB_CLIENT_ID=
# CHUDWARE_WEB_GITHUB_CLIENT_SECRET=

# Cloudflare Access — the OPERATOR door, scoped to /admin. Not the front door:
# ordinary users register above. Team domain is the issuer base (no trailing slash).
CHUDWARE_WEB_CF_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CHUDWARE_WEB_CF_AUD=YOUR_APPLICATION_AUD_TAG

# Local testing only — accepts X-Dev-User: you@example.com
CHUDWARE_WEB_DEV=0

# --- Per-account limits (multi-tenant hardening) ----------------------------
# Max bytes for a single upload (Content-Length checked before reading body).
CHUDWARE_WEB_MAX_UPLOAD_BYTES=104857600
# Per-account disk quota across workspace + bucket, in bytes. 0 disables.
CHUDWARE_WEB_MAX_USER_DISK_BYTES=2147483648
# Max websocket message size in bytes; larger frames are dropped before any
# forwarding (protects the 1 GiB gateway from OOM).
CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304

# --- Rate limits (per authenticated account) ---------------------------------
CHUDWARE_WEB_RATE_WRITES_PER_MIN=120          # mutating API calls / minute
CHUDWARE_WEB_RATE_UPLOADS_PER_MIN=30          # file uploads / minute
CHUDWARE_WEB_RATE_CHAT_PER_MIN=20             # chat messages / minute

# --- Transactional mail ------------------------------------------------------
# READ THIS ON A FRESH DEPLOY: the default backend is `console`, which only
# writes the rendered message to the gateway log. Verification links, password
# resets and dunning notices are queued and "delivered" to journalctl — the
# gateway looks perfectly healthy and no customer ever receives anything. Set
# CHUDWARE_MAIL_BACKEND to resend or smtp before taking signups.
#   console  log only (default; dev boxes and the test suite)
#   resend   HTTPS POST to api.resend.com; needs CHUDWARE_RESEND_API_KEY
#   smtp     any relay (Amazon SES above Resend's 100/day free tier)
# A backend named without its credential refuses to boot rather than queue
# mail that can never leave.
CHUDWARE_MAIL_BACKEND=console
# Envelope sender. Must be on a domain verified with the chosen provider, or
# every message is rejected or spam-filed. Default: Chudware <noreply@chudware.com>
CHUDWARE_MAIL_FROM=Chudware <noreply@chudware.com>
# Required when CHUDWARE_MAIL_BACKEND=resend. No default.
# CHUDWARE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Required when CHUDWARE_MAIL_BACKEND=smtp. Host has no default; port defaults
# to 587 and STARTTLS is used whenever the relay advertises it. Leave USER
# empty for an unauthenticated relay.
# CHUDWARE_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# CHUDWARE_SMTP_PORT=587
# CHUDWARE_SMTP_USER=
# CHUDWARE_SMTP_PASS=
# Outbound mail is additionally capped at 5 messages per recipient per hour,
# in code, so a held-down resend button cannot burn a daily allowance.

# --- Admin browser terminal (interactive shell as the gateway account) -------
# OFF by default — enabling exposes a root-of-the-app shell to admin users.
CHUDWARE_WEB_TERMINAL_ENABLED=0
CHUDWARE_WEB_TERMINAL_MAX_SESSIONS=8
CHUDWARE_WEB_TERMINAL_IDLE_TIMEOUT_SEC=1800

# Colon-separated allowlist of host directories an admin may browse/pick as a
# project root. Empty = home directory only.
# CHUDWARE_WEB_PROJECT_ROOTS=/home/liveuser:/srv/projects

# --- Web-native client (WASM /app + shared engine daemon) --------------------
# Both fall back to Webservice/deploy webd.env (written by install_webd.sh),
# then to deterministic defaults. Set here only to override.
# CHUDWARE_WEBD_SOCKET=/run/user/1000/chudware/hostd-chudwareweb.sock
# CHUDWARE_WORKSPACE_ROOT=/home/liveuser/chudware-workspace
# Max concurrent /engine bridges ONE account may hold open.
CHUDWARE_WEB_MAX_ENGINE_BRIDGES_PER_USER=4

# --- AI modeling agent (remote/subscription models only; no local models) ----
# Shared provider keys: put KEY=VALUE lines in
#   ~/chudware-web-data/ai_providers.env   (chmod 600; NEVER commit)
# e.g. OPENROUTER_API_KEY=... / ANTHROPIC_API_KEY=... / OPENAI_API_KEY=...
#      XAI_API_KEY=... / GEMINI_API_KEY=...
# These are resolved SERVER-SIDE by gateway/engine_bridge.py as the fallback
# when the host config carries no keys.* slot for a provider. Credentials are
# never sent to the browser, and client-supplied keys are stripped from
# agent-turn RPCs. Web turns spend the host account's quota.
