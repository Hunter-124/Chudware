# chudware-web gateway — copy to a gitignored .env / systemd EnvironmentFile
# Prefix: CHUDWARE_WEB_*

CHUDWARE_WEB_DATA_ROOT=~/chudware-web-data
CHUDWARE_WEB_HOST=127.0.0.1
CHUDWARE_WEB_PORT=8300

CHUDWARE_WEB_MAX_SESSIONS=3
CHUDWARE_WEB_MAX_HEAVY=2
CHUDWARE_WEB_SESSION_MEMORY=5g
CHUDWARE_WEB_SESSION_CPUS=2
CHUDWARE_WEB_SESSION_PIDS=2048
CHUDWARE_WEB_IDLE_TIMEOUT_SEC=1800
CHUDWARE_WEB_MIN_HOST_RAM_GIB=8
CHUDWARE_WEB_STREAM_PORT_BASE=8400

CHUDWARE_WEB_SESSION_IMAGE=localhost/chudware-session:latest
CHUDWARE_WEB_STREAM_BACKEND=selkies

# Cloudflare Access (prod). Team domain is the issuer base (no trailing slash).
CHUDWARE_WEB_CF_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
CHUDWARE_WEB_CF_AUD=YOUR_APPLICATION_AUD_TAG

# Local testing only — accepts X-Dev-User: you@example.com (must be in users.yaml)
CHUDWARE_WEB_DEV=0

# Optional override for allowlist path. PRODUCTION MUST set this to an
# untracked, chmod-600 file outside the repo — the tracked gateway/users.yaml
# is a template that grants nobody access (see Webservice/deploy/DEPLOYMENT.md).
# If the configured path does not exist, it is seeded from that template at
# startup, which locks EVERYONE out until you edit the runtime file.
# CHUDWARE_WEB_USERS_FILE=/path/to/users.yaml

# --- Per-account limits (multi-tenant hardening) ----------------------------
# Max concurrent modeling sessions ONE account may hold.
CHUDWARE_WEB_MAX_SESSIONS_PER_USER=1
# Hard lifetime cap per session (seconds); a user cannot hold a seat forever
# by keeping the stream warm. Default 28800 (8h).
CHUDWARE_WEB_MAX_SESSION_LIFETIME_SEC=28800
# Max bytes for a single upload (Content-Length checked before reading body).
CHUDWARE_WEB_MAX_UPLOAD_BYTES=104857600
# Per-account disk quota across workspace + bucket, in bytes. 0 disables.
CHUDWARE_WEB_MAX_USER_DISK_BYTES=2147483648
# Max websocket message size in bytes; larger frames are dropped before any
# forwarding (protects the 1 GiB gateway from OOM).
CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304

# --- Rate limits (per authenticated account) ---------------------------------
CHUDWARE_WEB_RATE_WRITES_PER_MIN=120          # mutating API calls / minute
CHUDWARE_WEB_RATE_UPLOADS_PER_MIN=30          # file uploads / minute
CHUDWARE_WEB_RATE_CHAT_PER_MIN=20             # chat messages / minute
CHUDWARE_WEB_RATE_SESSION_STARTS_PER_HOUR=20  # session launches / hour

# --- Admin browser terminal (interactive shell as the gateway account) -------
# OFF by default — enabling exposes a root-of-the-app shell to admin users.
CHUDWARE_WEB_TERMINAL_ENABLED=0
CHUDWARE_WEB_TERMINAL_MAX_SESSIONS=8
CHUDWARE_WEB_TERMINAL_IDLE_TIMEOUT_SEC=1800

# Colon-separated allowlist of host directories an admin may browse/pick as a
# project root. Empty = home directory only.
# CHUDWARE_WEB_PROJECT_ROOTS=/home/liveuser:/srv/projects

# --- AI modeling agent (remote/subscription models only; no local models) ----
# Shared provider keys for ALL sessions: put KEY=VALUE lines in
#   ~/chudware-web-data/ai_providers.env   (chmod 600; NEVER commit)
# e.g. OPENROUTER_API_KEY=... / ANTHROPIC_API_KEY=... / OPENAI_API_KEY=...
#      XAI_API_KEY=... / GEMINI_API_KEY=...
# Users may instead bring their own subscription/API key via the in-app
# Settings; it persists in their per-user HOME volume.
# CHUDWARE_WEB_SHARE_PROVIDER_KEYS=1 injects the shared keys above into EVERY
# user's session. Default 0: never share the operator's paid quota with
# untrusted accounts; users bring their own keys.
CHUDWARE_WEB_SHARE_PROVIDER_KEYS=0
