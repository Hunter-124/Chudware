---
/**
 * The part-builder showcase: a parametric part rebuilt feature by feature,
 * raymarched live, docked beside the FeatureManager that drives it.
 *
 * This used to be the page hero; the brand mark took that spot and this moved
 * down-page as a framed instrument. The copy column arrives through the
 * default slot so the page still owns its words.
 *
 * Progressive enhancement is unchanged: the server renders the real product
 * screenshot. Only once WebGL2 hands back a live context does the script swap
 * it for the canvas, so no JS, no WebGL, or a blocked bundle still shows the
 * product rather than an empty rectangle.
 */
import { HERO_STAGES } from '../scripts/hero-timeline';
---

<section class="section partshow">
  <div class="wrap partshow-grid">
    <div class="section-heading partshow-copy"><slot /></div>
    <div class="partshow-visual">
      <div class="partshow-box">
        <figure class="hero-shot partshow-shot" data-hero-shot>
          <img
            src="/images/modeling.png"
            width="1340"
            height="838"
            alt="The Chudware modeling workspace showing a shelled parametric enclosure beside its feature tree"
          />
        </figure>

        <div class="hero-stage partshow-stage" data-hero>
          <canvas class="hero-canvas" data-hero-canvas aria-hidden="true" hidden></canvas>
        </div>

        <figure class="hero-panel partshow-panel" data-hero-panel hidden>
          <figcaption class="hero-panel-head">
            <span class="hero-panel-title">FeatureManager</span>
            <span class="hero-panel-doc">bracket_v4.chud</span>
          </figcaption>
          <ol class="hero-tree">
            {HERO_STAGES.map((stage, index) => (
              <li class="hero-feature" data-hero-feature={index} data-state="done">
                <span class="hero-feature-mark" aria-hidden="true"></span>
                <span class="hero-feature-body">
                  <span class="hero-feature-label">{stage.label}</span>
                  <span class="hero-feature-detail">{stage.detail}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="hero-panel-foot">
            <span class="hero-kernel">Exact solids</span>
            <span class="hero-regen" data-hero-status>Rebuild complete</span>
          </div>
        </figure>
      </div>
      <p class="partshow-caption">Live render · the same ordered feature history the product replays, solved here as exact geometry rather than a stored picture of it.</p>
    </div>
  </div>
</section>

<style>
  @layer pages {
    .partshow-copy {
      margin-bottom: 0;
      align-self: center;
    }

    .partshow-visual {
      position: relative;
      min-width: 0;
    }

    /* The screenshot establishes the live render's exact aspect ratio. The
       feature history remains a separate instrument row, so neither surface
       covers or crops the captured product UI. */
    .partshow-box {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      border: var(--border) solid var(--line-hi);
      border-radius: var(--radius);
      background: var(--bg-deep);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .partshow-stage {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      min-width: 0;
      pointer-events: none;
      contain: strict;
    }


    .partshow-caption {
      margin-top: var(--s3);
      color: var(--faint);
      font: var(--step--1)/1.5 var(--mono);
    }

    .hero-canvas {
      width: 100%;
      height: 100%;
      /* The renderer owns the backing-store size; CSS only stretches it. */
      display: block;
      opacity: 0;
      transition: opacity 1.1s var(--ease);
    }

    .hero-canvas[data-ready] {
      opacity: 1;
    }

    /* A separate instrument row preserves the relationship between the live
       geometry and its feature history without imitating an in-product
       floating panel over a real screenshot. */
    .partshow-panel {
      position: relative;
      z-index: 2;
      grid-area: 2 / 1;
      margin: 0;
      border-width: var(--border) 0 0;
      border-style: solid;
      border-color: var(--line);
      background: var(--surface);
      font-family: var(--mono);
    }

    .hero-panel-head {
      display: flex;
      justify-content: space-between;
      gap: var(--s4);
      padding: var(--s2) var(--s3);
      border-bottom: var(--border) solid var(--line);
      font-size: var(--step--1);
    }

    .hero-panel-title {
      color: var(--technical);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-panel-doc {
      min-width: 0;
      overflow-wrap: anywhere;
      color: var(--faint);
    }
    .hero-tree {
      display: grid;
      margin: 0;
      padding: var(--s2) 0;
      list-style: none;
    }

    .hero-feature {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s2);
      align-items: center;
      padding: var(--s1) var(--s3);
      border-left: var(--border-strong) solid transparent;
      transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
    }

    .hero-feature-mark {
      width: var(--s3);
      height: var(--s3);
      border: var(--border) solid var(--line-hi);
      border-radius: var(--radius-sm);
      transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
        transform 0.3s var(--ease);
    }

    .hero-feature-body {
      display: grid;
      min-width: 0;
    }

    .hero-feature-label {
      color: var(--muted);
      font-size: var(--step--1);
      transition: color 0.3s var(--ease);
    }

    .hero-feature-detail {
      overflow: hidden;
      color: var(--faint);
      font-size: var(--step--2);
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .hero-feature[data-state="done"] .hero-feature-mark {
      border-color: var(--technical);
      background: color-mix(in srgb, var(--technical) 45%, transparent);
    }

    .hero-feature[data-state="done"] .hero-feature-label {
      color: var(--text);
    }

    .hero-feature[data-state="building"] {
      border-left-color: var(--accent);
      background: var(--accent-wash);
    }

    .hero-feature[data-state="building"] .hero-feature-mark {
      border-color: var(--accent);
      background: var(--accent);
      transform: scale(1.15);
    }

    .hero-feature[data-state="building"] .hero-feature-label {
      color: var(--text);
    }

    .hero-feature[data-state="building"] .hero-feature-detail {
      color: var(--accent-hi);
    }

    .hero-feature[data-state="pending"] {
      opacity: 0.4;
    }

    .hero-panel-foot {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--s2) var(--s4);
      padding: var(--s2) var(--s3);
      border-top: var(--border) solid var(--line);
      color: var(--faint);
      font-size: var(--step--2);
    }

    .hero-regen {
      color: var(--technical-hi);
    }

    .hero-shot {
      grid-area: 1 / 1;
      z-index: 0;
      min-width: 0;
      margin: 0;
      height: auto;
      background: var(--bg-deep);
    }

    .hero-shot img {
      display: block;
      width: 100%;
      height: auto;
      background: var(--bg-deep);
      object-fit: contain;
    }

    .partshow-grid {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
  }

  @layer responsive {
    @media (max-width: 60rem) {
      .partshow-grid {
        grid-template-columns: 1fr;
      }
    }

  }

  @layer motion {
    @media (prefers-reduced-motion: reduce) {
      .hero-canvas,
      .hero-feature,
      .hero-feature-mark,
      .hero-feature-label {
        transition: none;
      }
    }
  }
</style>

<script>
  import { createHero, type HeroHandle } from '../scripts/hero';
  import { HERO_STAGES } from '../scripts/hero-timeline';

  const stage = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const panel = document.querySelector<HTMLElement>('[data-hero-panel]');
  const status = document.querySelector<HTMLElement>('[data-hero-status]');
  const features = Array.from(
    document.querySelectorAll<HTMLElement>('[data-hero-feature]'),
  );

  if (stage && canvas && panel) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The feature history is now a separate row, so the rendered part stays
    // centered at every width instead of making room for an overlay.
    let hero: HeroHandle | null = null;
    let attempts = 0;
    let retry = 0;

    // The product screenshot underneath is the resting state. Previously
    // `data-ready` was set once and never cleared, so a context the driver
    // later reclaimed left a blank pane over the screenshot instead of letting
    // it show through — the failure a phone actually hits.
    const showShot = () => {
      delete canvas.dataset.ready;
      canvas.hidden = true;
      // The panel duplicates the FeatureManager already visible inside the
      // screenshot, so it belongs to the live render only.
      panel.hidden = true;
    };

    const teardown = () => {
      window.clearTimeout(retry);
      hero?.destroy();
      hero = null;
      showShot();
    };

    const boot = () => {
      if (hero) return;
      canvas.hidden = false;
      hero = createHero(canvas, {
        centered: true,
        panelDocked: () => false,
        still,
        onStage(index, building) {
          for (let i = 0; i < features.length; i++) {
            features[i].dataset.state = !building || i < index
              ? 'done'
              : i === index
                ? 'building'
                : 'pending';
          }
          if (status) {
            status.textContent = building
              ? `Rebuilding ${HERO_STAGES[index]?.label ?? ''}`
              : 'Rebuild complete';
          }
        },
        // Not an error: mobile drivers reclaim contexts under memory pressure
        // and when a page asks for more than they allow. Show the screenshot
        // and let `webglcontextrestored` bring the render back.
        onLost() {
          hero = null;
          showShot();
        },
      });

      if (hero) {
        // The screenshot is the fallback. It only steps aside once the canvas
        // has actually produced a context and a first frame.
        attempts = 0;
        canvas.dataset.ready = '';
        panel.hidden = false;
      } else if (++attempts < 4) {
        // Same GPU-warmup retry as the brand hero: parse-time null contexts
        // are transient, and the screenshot fallback is for real absence.
        showShot();
        retry = window.setTimeout(boot, 400);
      } else {
        showShot();
      }
    };

    canvas.addEventListener('webglcontextrestored', () => {
      attempts = 0;
      boot();
    });

    // Own a context only while the showcase is worth rendering. A phone's
    // WebGL context ceiling is low enough that this and the brand hero can
    // exceed it between them, and the driver's answer is to take one away —
    // so the two are never both live. Observe the framed box rather than the
    // canvas itself, because the canvas is hidden while the render is down and
    // a hidden element never intersects anything again.
    new IntersectionObserver(
      (entries) => {
        if (entries[entries.length - 1]?.isIntersecting) boot();
        else teardown();
      },
      { rootMargin: '100% 0px' },
    ).observe(stage.parentElement ?? stage);
  }
</script>
