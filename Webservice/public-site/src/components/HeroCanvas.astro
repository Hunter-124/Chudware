---
/**
 * The part-builder showcase: a parametric part rebuilt feature by feature,
 * raymarched live, docked beside the FeatureManager that drives it.
 *
 * This used to be the page hero; the brand mark took that spot and this moved
 * down-page as a framed instrument. The copy column arrives through the
 * default slot so the page still owns its words.
 *
 * Progressive enhancement is unchanged: the server renders the real product
 * screenshot. Only once WebGL2 hands back a live context does the script swap
 * it for the canvas, so no JS, no WebGL, or a blocked bundle still shows the
 * product rather than an empty rectangle.
 */
import { HERO_STAGES } from '../scripts/hero-timeline';
---

<section class="section partshow">
  <div class="wrap partshow-grid">
    <div class="section-heading partshow-copy"><slot /></div>
    <div class="partshow-visual">
      <div class="partshow-box">
        <figure class="hero-shot partshow-shot" data-hero-shot>
          <img
            src="/images/modeling.png"
            width="1340"
            height="838"
            alt="The Chudware modeling workspace showing a shelled parametric enclosure beside its feature tree"
          />
        </figure>

        <div class="hero-stage partshow-stage" data-hero>
          <canvas class="hero-canvas" data-hero-canvas aria-hidden="true" hidden></canvas>
        </div>

        <figure class="hero-panel partshow-panel" data-hero-panel data-lift hidden>
          <figcaption class="hero-panel-head">
            <span class="hero-panel-title">FeatureManager</span>
            <span class="hero-panel-doc">bracket_v4.chud</span>
          </figcaption>
          <ol class="hero-tree">
            {HERO_STAGES.map((stage, index) => (
              <li class="hero-feature" data-hero-feature={index} data-state="done">
                <span class="hero-feature-mark" aria-hidden="true"></span>
                <span class="hero-feature-body">
                  <span class="hero-feature-label">{stage.label}</span>
                  <span class="hero-feature-detail">{stage.detail}</span>
                </span>
              </li>
            ))}
          </ol>
          <div class="hero-panel-foot">
            <span class="hero-kernel">OCCT 7.9</span>
            <span class="hero-regen" data-hero-status>Rebuild complete</span>
          </div>
        </figure>
      </div>
      <p class="partshow-caption">Live render · boolean history replayed as a signed distance field — no mesh, no library.</p>
    </div>
  </div>
</section>

<style>
  @layer pages {
    .partshow-copy {
      margin-bottom: 0;
      align-self: center;
    }

    .partshow-visual {
      position: relative;
      min-width: 0;
    }

    /* The framed instrument: the shot defines the box, the live stage
       overlays it exactly and fades in once the renderer produces frames,
       and the panel docks over the near corner. The box is taller than the
       screenshot's native 16:10 so the panel fits beside the render. */
    .partshow-box {
      position: relative;
      aspect-ratio: 1.28;
      border: var(--border) solid var(--line-hi);
      border-radius: var(--radius);
      background: var(--bg-deep);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .partshow-stage {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      contain: strict;
    }

    .partshow-shot {
      z-index: 0;
    }

    .partshow-caption {
      margin-top: var(--s3);
      color: var(--faint);
      font: var(--step--1)/1.5 var(--mono);
    }

    .hero-canvas {
      width: 100%;
      height: 100%;
      /* The renderer owns the backing-store size; CSS only stretches it. */
      display: block;
      opacity: 0;
      transition: opacity 1.1s var(--ease);
    }

    .hero-canvas[data-ready] {
      opacity: 1;
    }

    /* The panel is a HUD docked over the render's near corner. Cosmetics live
       in the layer; the positioning is repeated unlayered below because
       global.css's motion layer gives every [data-lift] position: relative,
       and later layers beat earlier ones. */
    .partshow-panel {
      border: var(--border) solid var(--line);
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--surface) 78%, transparent);
      box-shadow: var(--shadow);
      backdrop-filter: blur(14px) saturate(1.3);
      font-family: var(--mono);
    }

    .hero-panel-head {
      display: flex;
      justify-content: space-between;
      gap: var(--s4);
      padding: var(--s2) var(--s3);
      border-bottom: var(--border) solid var(--line);
      font-size: var(--step--1);
    }

    .hero-panel-title {
      color: var(--technical);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .hero-panel-doc {
      color: var(--faint);
    }

    .hero-tree {
      display: grid;
      margin: 0;
      padding: var(--s2) 0;
      list-style: none;
    }

    .hero-feature {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--s2);
      align-items: center;
      padding: var(--s1) var(--s3);
      border-left: var(--border-strong) solid transparent;
      transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
    }

    .hero-feature-mark {
      width: 0.7rem;
      height: 0.7rem;
      border: var(--border) solid var(--line-hi);
      border-radius: 2px;
      transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
        transform 0.3s var(--ease);
    }

    .hero-feature-body {
      display: grid;
      min-width: 0;
    }

    .hero-feature-label {
      color: var(--muted);
      font-size: var(--step--1);
      transition: color 0.3s var(--ease);
    }

    .hero-feature-detail {
      overflow: hidden;
      color: var(--faint);
      font-size: 0.72rem;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .hero-feature[data-state="done"] .hero-feature-mark {
      border-color: var(--technical);
      background: color-mix(in srgb, var(--technical) 45%, transparent);
    }

    .hero-feature[data-state="done"] .hero-feature-label {
      color: var(--text);
    }

    .hero-feature[data-state="building"] {
      border-left-color: var(--accent);
      background: var(--accent-wash);
    }

    .hero-feature[data-state="building"] .hero-feature-mark {
      border-color: var(--accent);
      background: var(--accent);
      transform: scale(1.15);
    }

    .hero-feature[data-state="building"] .hero-feature-label {
      color: var(--text);
    }

    .hero-feature[data-state="building"] .hero-feature-detail {
      color: var(--accent-hi);
    }

    .hero-feature[data-state="pending"] {
      opacity: 0.4;
    }

    .hero-panel-foot {
      display: flex;
      justify-content: space-between;
      gap: var(--s4);
      padding: var(--s2) var(--s3);
      border-top: var(--border) solid var(--line);
      color: var(--faint);
      font-size: 0.72rem;
    }

    .hero-regen {
      color: var(--technical-hi);
    }

    .hero-shot {
      margin: 0;
      height: 100%;
      background: var(--bg-deep);
    }

    .hero-shot img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center;
    }

    .partshow-grid {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }
  }

  @layer responsive {
    @media (max-width: 60rem) {
      .partshow-grid {
        grid-template-columns: 1fr;
      }
    }
  }

  @layer motion {
    @media (prefers-reduced-motion: reduce) {
      .hero-canvas,
      .hero-feature,
      .hero-feature-mark,
      .hero-feature-label {
        transition: none;
      }
    }
  }
  /* Unlayered on purpose: author styles outside a layer outrank every
     @layer, which is what lets this positioning beat the motion layer's
     [data-lift] { position: relative } without an !important arms race. */
  .partshow-panel {
    position: absolute;
    z-index: 2;
    right: var(--s4);
    bottom: var(--s4);
    width: min(19rem, 62%);
    margin: 0;
  }

  @media (max-width: 60rem) {
    .partshow-panel {
      position: relative;
      z-index: 2;
      right: auto;
      bottom: auto;
      width: auto;
      margin: var(--s4);
    }
  }
</style>

<script>
  import { createHero } from '../scripts/hero';
  import { HERO_STAGES } from '../scripts/hero-timeline';

  const stage = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const panel = document.querySelector<HTMLElement>('[data-hero-panel]');
  const status = document.querySelector<HTMLElement>('[data-hero-status]');
  const features = Array.from(
    document.querySelectorAll<HTMLElement>('[data-hero-feature]'),
  );

  if (stage && canvas && panel) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let attempts = 0;
    const boot = () => {
      canvas.hidden = false;
      const hero = createHero(canvas, {
        centered: true,
        still,
        onStage(index, building) {
          for (let i = 0; i < features.length; i++) {
            features[i].dataset.state = !building || i < index
              ? 'done'
              : i === index
                ? 'building'
                : 'pending';
          }
          if (status) {
            status.textContent = building
              ? `Rebuilding ${HERO_STAGES[index]?.label ?? ''}`
              : 'Rebuild complete';
          }
        },
      });

      if (hero) {
        // The screenshot is the fallback. It only steps aside once the canvas
        // has actually produced a context and a first frame.
        canvas.dataset.ready = '';
        panel.hidden = false;
      } else if (++attempts < 4) {
        // Same GPU-warmup retry as the brand hero: parse-time null contexts
        // are transient, and the screenshot fallback is for real absence.
        canvas.hidden = true;
        setTimeout(boot, 400);
      } else {
        canvas.hidden = true;
        stage.hidden = true;
      }
    };
    boot();
  }
</script>
