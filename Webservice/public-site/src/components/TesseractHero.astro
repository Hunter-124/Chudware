---
/**
 * The brand-mark hero: the tesseract that turns inside the product, live at
 * full stage size behind the copy.
 *
 * Structure mirrors the part-builder hero it replaces at the top of the page:
 * the canvas is a full-bleed direct child of the positioned `.hero`, copy
 * arrives through the default slot, and the architecture strip through a
 * named one. Progressive enhancement is the same contract too — without JS
 * or WebGL2 the stage holds the static mark at the brand pose instead of an
 * empty rectangle, and prefers-reduced-motion gets the same pose as a single
 * parked frame (which is, not coincidentally, the OS icon's frame).
 */
---

<section class="hero bhero">
  <div class="bhero-stage" data-tess>
    <canvas class="bhero-canvas" data-tess-canvas aria-hidden="true" hidden></canvas>
    <div class="bhero-veil" aria-hidden="true"></div>
    <div class="bhero-frame" aria-hidden="true">
      <i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>
      <div class="bhero-hud bhero-hud-tl">
        <span class="bhero-hud-title">Fig. 01 — Tesseract / 8-cell</span>
        <span>Brand mark · live render</span>
      </div>
      <div class="bhero-hud bhero-hud-tr">
        <span>Projection 4D → 3D → 2D</span>
      </div>
      <div class="bhero-hud bhero-hud-bl">
        <span>Vertices 16 · Edges 32 · Cells 8</span>
      </div>
      <div class="bhero-hud bhero-hud-br">
        <span>Rotation xy × zw · 1:φ⁻¹</span>
        <span class="bhero-angle">θ<sub>zw</sub> <b data-tess-angle>0.0</b>°</span>
      </div>
    </div>
    <figure class="bhero-fallback" data-tess-fallback>
      <img src="/assets/logo.svg" width="320" height="320" alt="The Chudware brand mark: a tesseract" />
    </figure>
  </div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy bhero-copy"><slot /></div>
      <div class="bhero-spacer" aria-hidden="true"></div>
    </div>
    <div class="hero-strip"><slot name="strip" /></div>
  </div>
</section>

<style>
  @layer pages {
    .bhero {
      /* Taller than the part hero was: the mark wants air. */
      min-height: calc(100svh - var(--header-height));
    }

    .bhero-stage {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      contain: strict;
    }

    .bhero-canvas {
      width: 100%;
      height: 100%;
      display: block;
      opacity: 0;
      transition: opacity 1.4s var(--ease);
    }

    .bhero-canvas[data-ready] {
      opacity: 1;
    }

    /* Copy legibility over the render: solid at the left column, open by the
       middle so the mark is never veiled. */
    .bhero-veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        93deg,
        var(--bg) 16%,
        color-mix(in srgb, var(--bg) 82%, transparent) 32%,
        color-mix(in srgb, var(--bg) 22%, transparent) 52%,
        transparent 68%
      );
    }

    /* Ambient washes behind the mark — depth the additive canvas composits
       over, since it clears to transparent. */
    .bhero-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(46rem 34rem at 70% 46%, var(--technical-wash), transparent 62%),
        radial-gradient(30rem 24rem at 78% 30%, var(--accent-wash), transparent 70%);
    }

    /* The HUD frame: instrument chrome around the stage, honest labels only. */
    .bhero-frame {
      position: absolute;
      top: clamp(.75rem, 2vw, 1.5rem);
      left: clamp(.75rem, 2vw, 1.5rem);
      right: clamp(.75rem, 2vw, 1.5rem);
      /* The architecture strip owns the bottom of the hero; the instrument
         frame ends above it instead of colliding with it. */
      bottom: 7.25rem;
      font: .66rem/1.5 var(--mono);
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--faint);
    }

    .bhero-frame i {
      position: absolute;
      width: 1.1rem;
      height: 1.1rem;
      border: 0 solid var(--line-hi);
    }

    .bhero-frame .tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
    .bhero-frame .tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
    .bhero-frame .bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
    .bhero-frame .br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

    .bhero-hud {
      position: absolute;
      display: grid;
      gap: var(--s1);
      padding: var(--s2);
    }

    /* Over the mark's lane, not the copy's: at any viewport shorter than
       ~1000px the hero copy rides up into the top-left corner, and a caption
       parked there lands on the eyebrow. */
    .bhero-hud-tl { top: var(--s2); left: 50%; }
    .bhero-hud-tr { top: var(--s2); right: var(--s3); text-align: right; }
    .bhero-hud-bl { bottom: var(--s2); left: var(--s3); }
    .bhero-hud-br { bottom: var(--s2); right: var(--s3); text-align: right; }

    .bhero-hud-title {
      color: var(--technical);
    }

    .bhero-angle b {
      color: var(--technical-hi);
      font-weight: 400;
      /* Tabular width so the live readout doesn't wobble the frame. */
      display: inline-block;
      min-width: 4.2ch;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .bhero-fallback {
      position: absolute;
      top: 50%;
      left: 70%;
      margin: 0;
      transform: translate(-50%, -50%);
      opacity: .9;
    }

    .bhero-fallback img {
      width: min(38vmin, 20rem);
      height: auto;
      filter: drop-shadow(0 0 2.5rem var(--technical-wash));
    }

    .bhero-fallback[hidden] {
      display: none;
    }

    /* The copy column; the spacer keeps the grid's right lane clear for the
       mark without imposing a height. */
    .bhero-copy {
      position: relative;
      z-index: 1;
      gap: var(--s6);
    }

    .bhero-copy h1 {
      max-width: 12ch;
    }

    /* Staggered entrance, transform-only so it composes cleanly. */
    @media (prefers-reduced-motion: no-preference) {
      .bhero-copy > * {
        animation: bhero-in .9s var(--ease) both;
      }
      .bhero-copy > *:nth-child(2) { animation-delay: .08s; }
      .bhero-copy > *:nth-child(3) { animation-delay: .16s; }
      .bhero-copy > *:nth-child(4) { animation-delay: .24s; }
      .bhero-copy > *:nth-child(5) { animation-delay: .32s; }
      @keyframes bhero-in {
        from { opacity: 0; translate: 0 var(--s5); }
        to { opacity: 1; translate: none; }
      }
      .bhero-frame { animation: bhero-in 1.2s var(--ease) .35s both; }
    }
  }

  @layer responsive {
    @media (max-width: 60rem) {
      /* Portrait: the mark drops behind the copy as a centred backdrop, the
         HUD thins to what still reads. */

      /* The stage stops spanning the whole hero. Portrait copy flows *under*
         the mark's lane, which makes the hero about 1.7 screens tall on a
         phone — so a full-bleed stage was asking the GPU for a canvas nearly
         twice the viewport, most of it behind opaque copy, and putting the
         figure's centre somewhere below the fold. Bounding it to the reserved
         lane cuts the backing store to roughly a third and puts the mark
         where the layout already made room for it. */
      .bhero-stage {
        bottom: auto;
        height: calc(38svh + 12rem);
      }

      .bhero-veil {
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--bg) 55%, transparent) 0%,
          color-mix(in srgb, var(--bg) 30%, transparent) 45%,
          var(--bg) 92%
        );
      }

      .bhero-fallback {
        left: 50%;
        top: 55%;
      }

      /* The two static caption blocks go; the live θ readout stays, because it
         is the tell that the mark is a real render rather than a picture. Both
         surviving blocks stack down the left edge: the title block used to sit
         at `left: 50%`, which on a 390 px viewport is a 183 px column that
         wraps "8-cell" onto a second line and crowds the θ readout beside it. */
      .bhero-hud-tr,
      .bhero-hud-bl,
      .bhero-frame .bl,
      .bhero-frame .br {
        display: none;
      }

      .bhero-hud-tl {
        left: var(--s3);
        /* Bounded by the frame it sits in, not by a character count: at .6rem
           mono with .12em tracking, a 28ch cap is ~190px and wraps both labels
           onto second lines inside a frame that is 340px wide. */
        max-width: calc(100% - var(--s3));
      }

      .bhero-hud-br {
        top: 4.75rem;
        right: auto;
        bottom: auto;
        left: var(--s3);
        text-align: left;
      }

      /* The frame ends with the stage now, not 7.25rem above the hero's
         bottom — that offset was measured against the architecture strip,
         which no longer shares the stage's box on portrait. */
      .bhero-frame {
        bottom: var(--s2);
      }

      .bhero-spacer {
        /* Reserve the mark's lane so copy doesn't sit on its centre. */
        min-height: 38svh;
        order: -1;
      }
    }

    @media (max-width: 45rem) {
      .bhero-frame {
        font-size: .6rem;
      }
    }
  }
</style>

<script>
  import { createTesseract, type TesseractHandle } from '../scripts/tesseract';

  const stage = document.querySelector<HTMLElement>('[data-tess]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-tess-canvas]');
  const fallback = document.querySelector<HTMLElement>('[data-tess-fallback]');
  const angle = document.querySelector<HTMLElement>('[data-tess-angle]');

  if (stage && canvas) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mark: TesseractHandle | null = null;
    let attempts = 0;
    let retry = 0;

    // The static mark is the resting state, and every path that has no live
    // render returns to it. Previously `data-ready` was set once and never
    // cleared, so a context the driver later reclaimed left an empty rectangle
    // where the brand mark should be — which is precisely what a phone does.
    const showFallback = () => {
      delete canvas.dataset.ready;
      canvas.hidden = true;
      fallback?.removeAttribute('hidden');
    };

    const teardown = () => {
      window.clearTimeout(retry);
      mark?.destroy();
      mark = null;
      showFallback();
    };

    const boot = () => {
      if (mark) return;
      canvas.hidden = false;
      mark = createTesseract(canvas, {
        still,
        onAngle(deg) {
          if (angle) angle.textContent = deg.toFixed(1);
        },
        // Not an error: mobile drivers reclaim contexts under memory pressure
        // and when a page asks for more than they allow. Fall back to the
        // static mark and let `webglcontextrestored` bring the render back.
        onLost() {
          mark = null;
          showFallback();
        },
      });

      if (mark) {
        attempts = 0;
        canvas.dataset.ready = '';
        fallback?.setAttribute('hidden', '');
      } else if (++attempts < 4) {
        // A GPU-process warmup race can hand back a null context at parse
        // time and a live one a few hundred milliseconds later. Retry before
        // conceding to the fallback.
        showFallback();
        retry = window.setTimeout(boot, 400);
      } else {
        showFallback();
      }
    };

    canvas.addEventListener('webglcontextrestored', () => {
      attempts = 0;
      boot();
    });

    // Own a context only while the stage is worth rendering. A phone's WebGL
    // context ceiling is low enough that this hero and the part-builder
    // showcase further down the page can exceed it between them, and the
    // driver's answer is to take one away — so the two are never both live.
    // One viewport of lead time means the render is already running by the
    // time the stage scrolls into view.
    new IntersectionObserver(
      (entries) => {
        if (entries[entries.length - 1]?.isIntersecting) boot();
        else teardown();
      },
      { rootMargin: '100% 0px' },
    ).observe(stage);
  }
</script>
