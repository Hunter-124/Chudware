---
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/product/', label: 'Product' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/docs/', label: 'Docs' },
  { href: '/pricing/', label: 'Pricing' },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111310" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <title>{title} · Chudware</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand tap" href="/" aria-label="Chudware home">
          <img src="/assets/logo.svg" width="32" height="32" alt="" />
          <span>CHUDWARE</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          {nav.map((item) => <a class="tap" href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="sign-in tap" href="https://app.chudware.com/signin">Sign in</a>
          <a class="button button-small" href="https://app.chudware.com/signup">Create an account</a>
        </div>
        <details class="mobile-nav">
          <summary class="tap"><Icon name="menu" /><span>Menu</span></summary>
          <nav aria-label="Mobile primary">
            {nav.map((item) => <a class="tap" href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
            <a class="tap" href="https://app.chudware.com/signin">Sign in</a>
            <a class="tap mobile-download" href="https://app.chudware.com/signup">Create an account</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand tap" href="/"><img src="/assets/logo.svg" width="28" height="28" alt="" /><span>CHUDWARE</span></a>
          <p>Chudware is built for engineers: design, simulation, manufacturing, product data, electronics, and AI in one workspace.</p>
        </div>
        <nav aria-label="Capability links">
          <strong>Capabilities</strong>
          <a class="tap" href="/product/modeling/">Modeling</a><a class="tap" href="/product/assemblies/">Assemblies</a><a class="tap" href="/product/simulation/">Simulation</a><a class="tap" href="/product/polymesh/">PolyMesh FEA</a><a class="tap" href="/product/cam/">CAM &amp; manufacture</a><a class="tap" href="/product/plm/">PLM</a><a class="tap" href="/product/copilot/">AI copilot</a><a class="tap" href="/product/reverse-engineering/">Reverse engineering</a>
        </nav>
        <nav aria-label="Explore links">
          <strong>Explore</strong>
          <a class="tap" href="/product/">Overview</a><a class="tap" href="/gallery/">Gallery</a><a class="tap" href="/pricing/">Pricing</a><a class="tap" href="/download/">Download</a><a class="tap" href="/docs/">Docs</a><a class="tap" href="/faq/">FAQ</a><a class="tap" href="/changelog/">Changelog</a>
        </nav>
        <nav aria-label="Company and legal links">
          <strong>Company &amp; legal</strong>
          <a class="tap" href="/about/">About</a><a class="tap" href="/open-source/">Open source</a><a class="tap" href="/security/">Security</a><a class="tap" href="/contact/">Contact</a><a class="tap" href="/legal/terms/">Terms</a><a class="tap" href="/legal/privacy/">Privacy</a><a class="tap" href="/legal/eula/">EULA</a><a class="tap" href="/legal/refunds/">Refunds</a>
        </nav>
      </div>
      <div class="wrap footer-bottom"><span>© 2026 Chudware</span><span>Engineering CAD from design through production.</span></div>
    </footer>

  </body>
</html>
