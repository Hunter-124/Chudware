---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/company.css';
---
<BaseLayout title="Page not found" description="The requested Chudware page could not be found.">
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404 · Not found</p>
      <h1>This page does not exist.</h1>
      <p class="lede">Check the address, or continue to the product, documentation, or account portal.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap co-grid">
      <article class="co-card">
        <p class="eyebrow icon-row"><Icon name="overview" />Start over</p>
        <h3>The front page</h3>
        <p>What Chudware is, what it covers, and where the work happens.</p>
        <a class="text-link" href="/">Go home <Icon name="arrow-right" /></a>
      </article>
      <article class="co-card">
        <p class="eyebrow icon-row"><Icon name="search" />Documentation</p>
        <h3>Task guides and reference</h3>
        <p>Sketching, first parts, assemblies, CAM, the copilot, and troubleshooting — all searchable.</p>
        <a class="text-link" href="/docs/">Open the docs <Icon name="arrow-right" /></a>
      </article>
      <article class="co-card">
        <p class="eyebrow icon-row"><Icon name="download" />Download</p>
        <h3>The desktop app</h3>
        <p>Signed builds for Windows, Linux, and macOS, plus a one-line Linux install.</p>
        <a class="text-link" href="/download/">Get Chudware <Icon name="arrow-right" /></a>
      </article>
      <article class="co-card">
        <p class="eyebrow icon-row"><Icon name="team" />Contact</p>
        <h3>A person, not a queue</h3>
        <p>Sales, support, security, privacy, and legal — each on its own address.</p>
        <a class="text-link" href="/contact/">Contact Chudware <Icon name="arrow-right" /></a>
      </article>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap section-heading">
      <p class="eyebrow">Or skip the site</p>
      <h2>Open the workspace instead.</h2>
      <div class="actions"><a class="button" href="https://app.chudware.com/signup">Create an account</a><a class="button button-secondary" href="https://app.chudware.com/signin">Sign in</a></div>
    </div>
  </section>
</BaseLayout>
