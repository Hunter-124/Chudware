---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Pricing" description="Chudware pricing: a free 14-day trial, Desktop, Studio with the browser workspace, education rates, and enterprise deployment.">
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Pricing</p>
      <h1>Two plans. Same product. Pick where you run it.</h1>
      <p class="lede">Plans are monthly, per account. Desktop and Studio include every workspace; Studio adds the browser workspace and more storage. Verified <strong>.edu</strong> accounts get the education rate at checkout.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap access-grid">
      <article class="access-option">
        <p class="eyebrow">Trial</p>
        <h2>Everything, free for 14 days.</h2>
        <p class="price"><span class="price-amount">$0</span> <span class="price-period">· 14 days · no card required</span></p>
        <ul class="fact-list"><li>Browser workspace and desktop app</li><li>5 GB of account storage</li><li>Modeling, assemblies, CAM, PLM, simulation, reverse engineering, and copilot</li></ul>
        <a class="button button-secondary" href="https://app.chudware.com/signup">Start a trial</a>
      </article>
      <article class="access-option access-primary">
        <p class="eyebrow">Desktop</p>
        <h2>Run Chudware on your workstation.</h2>
        <p class="price"><span class="price-amount">Monthly</span> <span class="price-period">· price shown at checkout</span></p>
        <ul class="fact-list"><li>Desktop app for Windows, Linux, and macOS</li><li>Per-account license; revoke devices yourself</li><li>5 GB of account storage</li><li>Education rate for verified .edu accounts</li><li>Cancel any time; access runs to the end of the period</li></ul>
        <a class="button" href="https://app.chudware.com/signup">Choose Desktop</a>
      </article>
      <article class="access-option access-primary">
        <p class="eyebrow">Studio</p>
        <h2>Desktop, plus the browser workspace.</h2>
        <p class="price"><span class="price-amount">Monthly</span> <span class="price-period">· price shown at checkout</span></p>
        <ul class="fact-list"><li>Everything in Desktop</li><li>Browser workspace — nothing to install</li><li>100 GB of account storage</li><li>Education rate for verified .edu accounts</li><li>Works in any modern desktop browser</li></ul>
        <a class="button" href="https://app.chudware.com/signup">Choose Studio</a>
      </article>
      <article class="access-option">
        <p class="eyebrow">AI provider</p>
        <h2>AI runs on your own provider account.</h2>
        <p>The copilot uses the provider account or API key you connect. Whatever that provider charges is between you and them.</p>
        <ul class="fact-list"><li>Sign in with a provider account or paste an API key in Provider settings</li><li>Never paste provider credentials into chat or a project note</li><li>Chudware doesn't sell tokens or resell model capacity</li></ul>
        <a class="button button-secondary" href="/docs/ai-copilot/">Configure the copilot</a>
      </article>
      <article class="access-option access-contact">
        <p class="eyebrow">Enterprise</p>
        <h2>Organization deployment and billing.</h2>
        <p>Enterprise accounts include the desktop app, the browser workspace, 1 TB of storage, and organization billing. Contact us about deployment and access requirements.</p>
        <a class="text-link" href="mailto:sales@chudware.com">Contact sales <Icon name="arrow-right" /></a>
      </article>
    </div>
  </section>

  <section class="section pricing-principles">
    <div class="wrap split">
      <header class="section-heading">
        <p class="eyebrow">Billing</p>
        <h2>Subscriptions are managed from your account.</h2>
        <p class="lede">Stripe processes card payments. Use the billing section of your account to change plan, update a payment method, download invoices, or cancel. Cancellation takes effect at the end of the period already paid for.</p>
      </header>
      <div class="pricing-note">
        <p class="eyebrow">Terms at a glance</p>
        <p>Prices are in US dollars and exclude taxes Stripe must collect for your location.</p>
        <p>Verified <code>.edu</code> accounts see the education rate at checkout.</p>
        <p>Licensing is per account. Desktop devices can be revoked from that account and are not transferable. See the <a class="text-link" href="/legal/eula/">EULA</a>.</p>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap section-heading">
      <p class="eyebrow">Get started</p>
      <h2>Start with the trial.</h2>
      <div class="actions"><a class="button" href="https://app.chudware.com/signup">Create an account</a><a class="button button-secondary" href="/download/">Download the desktop app</a></div>
    </div>
  </section>
</BaseLayout>
