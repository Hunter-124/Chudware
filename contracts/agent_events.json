    {"kind": "dag.node.approval_required", "required_fields": ["node_id"], "optional": true, "emitter_note": "services/dag executor"},
    {"kind": "dag.node.manual_required", "required_fields": ["node_id"], "optional": true, "emitter_note": "services/dag executor"},
