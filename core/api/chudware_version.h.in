// Generated by CMake at CONFIGURE time from core/api/chudware_version.h.in.
// DO NOT EDIT and do not commit the generated copy — it lands in the build tree
// (<build>/generated/api/chudware_version.h) and is written by
// core/cmake/ChudwareVersion.cmake.
//
// CHUDWARE_VERSION is the product semver, taken from the nearest reachable
// annotated git tag shaped v<major>.<minor>.<patch>. With no such tag reachable
// the version is 0.0.0 and CHUDWARE_BUILD_DIRTY is 1 — an untagged build is never
// a release, whatever the working tree looks like.
//
// This is NOT the same thing as CHUDWARE_HOSTD_BUILD_ID (core/hostd/version_info.h):
// that one is a per-BUILD `git describe` stamp used to detect a stale running
// daemon. This one changes only when a tag does.
#pragma once

#define CHUDWARE_VERSION       "@CHUDWARE_VERSION@"
#define CHUDWARE_VERSION_MAJOR @CHUDWARE_VERSION_MAJOR@
#define CHUDWARE_VERSION_MINOR @CHUDWARE_VERSION_MINOR@
#define CHUDWARE_VERSION_PATCH @CHUDWARE_VERSION_PATCH@
#define CHUDWARE_GIT_SHA       "@CHUDWARE_GIT_SHA@"
#define CHUDWARE_BUILD_DIRTY   @CHUDWARE_BUILD_DIRTY@
#define CHUDWARE_BUILD_DATE    "@CHUDWARE_BUILD_DATE@"

// The one-line form every CLI surface prints: `chudware --version`,
// `chudware-hostd --status`, and the About modal all render this, so they can
// never disagree.
#define CHUDWARE_VERSION_LINE \
    CHUDWARE_VERSION " (" CHUDWARE_GIT_SHA ", " CHUDWARE_BUILD_DATE ")"
