# Validate managed source before any upstream CMake runs. Local developer trees
# must be selected explicitly, never inferred from an existing cache directory.
include_guard(GLOBAL)
include(FetchContent)
find_package(Git REQUIRED)

function(chudware_require_pinned_git directory commit)
  execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${directory}" rev-parse HEAD
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _rc EQUAL 0 OR NOT _head STREQUAL commit)
    message(FATAL_ERROR "Unverified Git source identity: ${directory}; expected ${commit}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${directory}"
    for-each-ref "--format=%(refname)" refs/replace/
    RESULT_VARIABLE _replace_rc OUTPUT_VARIABLE _replacements OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _replace_rc EQUAL 0 OR _replacements)
    message(FATAL_ERROR "Managed Git replacement refs are forbidden: ${directory}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${directory}" fsck --full --no-reflogs
    RESULT_VARIABLE _rc OUTPUT_QUIET ERROR_QUIET)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "Corrupt Git source objects: ${directory}")
  endif()
endfunction()

function(chudware_materialize_pinned_git directory commit destination)
  chudware_require_pinned_git("${directory}" "${commit}")
  set(_archive "${destination}.tar")
  get_filename_component(_parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${_parent}")
  execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${directory}" archive
    --format=tar "--output=${_archive}" "${commit}"
    RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "Pinned Git object export failed: ${directory}")
  endif()
  # Export authenticated objects into a fresh staging tree. Compare every source
  # file, then retain equal managed bytes/mtimes to avoid rebuilding the project.
  set(_staging "${destination}.staging")
  file(REMOVE_RECURSE "${_staging}")
  file(MAKE_DIRECTORY "${_staging}")
  file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_staging}")
  file(REMOVE "${_archive}")
  file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_staging}" "${_staging}/*")
  foreach(_file IN LISTS _files)
    if(NOT EXISTS "${directory}/${_file}")
      message(FATAL_ERROR "Modified managed Git source rejected before CMake: ${directory}/${_file}")
    endif()
    file(SHA256 "${_staging}/${_file}" _expected)
    file(SHA256 "${directory}/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Modified managed Git source rejected before CMake: ${directory}/${_file}")
    endif()
  endforeach()
  if(IS_SYMLINK "${destination}")
    file(REMOVE "${destination}")
  endif()
  file(GLOB_RECURSE _old LIST_DIRECTORIES TRUE RELATIVE "${destination}" "${destination}/*")
  foreach(_file IN LISTS _old)
    list(FIND _files "${_file}" _found)
    if(IS_SYMLINK "${destination}/${_file}" OR (NOT IS_DIRECTORY "${destination}/${_file}" AND _found EQUAL -1))
      file(REMOVE "${destination}/${_file}")
    endif()
  endforeach()
  foreach(_file IN LISTS _files)
    get_filename_component(_parent "${destination}/${_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    if(EXISTS "${destination}/${_file}" AND NOT IS_DIRECTORY "${destination}/${_file}")
      file(SHA256 "${_staging}/${_file}" _expected)
      file(SHA256 "${destination}/${_file}" _existing)
      if(_existing STREQUAL _expected)
        continue()
      endif()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
      "${_staging}/${_file}" "${destination}/${_file}" RESULT_VARIABLE _copy_rc)
    if(NOT _copy_rc EQUAL 0)
      message(FATAL_ERROR "Authenticated source publication failed: ${destination}/${_file}")
    endif()
  endforeach()
  file(REMOVE_RECURSE "${_staging}")
endfunction()

function(chudware_populate_pinned_git name repository commit)
  string(TOUPPER "${name}" _upper)
  if(FETCHCONTENT_SOURCE_DIR_${_upper})
    if(NOT CHUDWARE_DEVELOPER_BUILD OR DEFINED ENV{CI} OR DEFINED ENV{CHUDWARE_RELEASE_CHANNEL})
      message(FATAL_ERROR "Local ${name} source override is development-only")
    endif()
    message(WARNING "${name}: LOCAL SOURCE ${FETCHCONTENT_SOURCE_DIR_${_upper}}; not authenticated release source")
    set(${name}_SOURCE_DIR "${FETCHCONTENT_SOURCE_DIR_${_upper}}" PARENT_SCOPE)
    set(${name}_BINARY_DIR "${CMAKE_BINARY_DIR}/_deps/${name}-build" PARENT_SCOPE)
    return()
  endif()
  # Shallow fetch by full commit, not a mutable tag. No dependency-provider or
  # generated population script may execute cached source before validation.
  set(_cached "${FETCHCONTENT_BASE_DIR}/${name}-git-${commit}")
  # Reuse only already verified legacy Git caches. Archive-only caches from
  # older builds stay untouched; acquire their pinned source in a new directory.
  set(_legacy "${FETCHCONTENT_BASE_DIR}/${name}-src")
  if(NOT EXISTS "${_cached}" AND EXISTS "${_legacy}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${_legacy}" rev-parse HEAD
      RESULT_VARIABLE _legacy_rc OUTPUT_VARIABLE _legacy_head OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_legacy_rc EQUAL 0 AND _legacy_head STREQUAL commit)
      set(_cached "${_legacy}")
    endif()
  endif()
  if(EXISTS "${_cached}")
    chudware_require_pinned_git("${_cached}" "${commit}")
  else()
    execute_process(COMMAND "${GIT_EXECUTABLE}" init "${_cached}" RESULT_VARIABLE _rc)
    if(_rc EQUAL 0)
      execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${_cached}"
        -c http.sslVerify=true -c credential.helper= -c core.hooksPath= fetch --depth 1 "${repository}" "${commit}" RESULT_VARIABLE _rc)
    endif()
    if(_rc EQUAL 0)
      execute_process(COMMAND "${GIT_EXECUTABLE}" --no-replace-objects -C "${_cached}"
        -c core.hooksPath= checkout --detach "${commit}" RESULT_VARIABLE _rc)
    endif()
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "Pinned ${name} fetch failed (${_rc}); incomplete cache was not consumed")
    endif()
  endif()
  set(${name}_BINARY_DIR "${FETCHCONTENT_BASE_DIR}/${name}-build" PARENT_SCOPE)
  set(_source "${CMAKE_BINARY_DIR}/authenticated-source/${name}")
  chudware_materialize_pinned_git("${_cached}" "${commit}" "${_source}")
  set(${name}_SOURCE_DIR "${_source}" PARENT_SCOPE)
endfunction()
