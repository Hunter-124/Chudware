{
  "schema": "aicad.effort/1",
  "level": "standard",
  "mode": "simple",
  "levels": [
    {
      "id": "eco",
      "label": "Eco",
      "hint": "Fewest tokens: councils and trigger packs off, shallow delegation, compact context. Fastest and cheapest; less double-checking."
    },
    {
      "id": "standard",
      "label": "Standard",
      "hint": "Shipped defaults: full machinery on local models (their tokens are free), lean spending on paid frontier models."
    },
    {
      "id": "deliberate",
      "label": "Deliberate",
      "hint": "More double-checking everywhere: cognition ladder and councils always on, even on paid models. Slower and costlier, more rigorous."
    },
    {
      "id": "maximum",
      "label": "Maximum",
      "hint": "Everything on at full budgets on every tier, paid or not. Highest cost and latency, maximum rigor."
    }
  ],
  "groups": [
    "deliberation",
    "parallelization",
    "safety",
    "context"
  ],
  "knobs": {
    "deliberation": {
      "group": "deliberation",
      "type": "enum",
      "choices": [
        "full",
        "standard",
        "minimal"
      ],
      "label": "Deliberation dial",
      "doc": "Master dial (\u00a78 1.3): gates councils, ponders, trigger packs."
    },
    "ladder": {
      "group": "deliberation",
      "type": "enum",
      "choices": [
        "mandatory",
        "optional",
        "off"
      ],
      "label": "Cognition ladder",
      "doc": "\u00a722 rungs A-D. Validators always run regardless."
    },
    "ladder_max_bounces": {
      "group": "deliberation",
      "type": "int",
      "label": "Ladder bounces",
      "doc": "Validator bounces per rung before escalation (shipped: ladder.MAX_BOUNCES)."
    },
    "council": {
      "group": "deliberation",
      "type": "enum",
      "choices": [
        "always",
        "risk_gated",
        "off"
      ],
      "label": "Councils",
      "doc": "\u00a719 build-strategy councils: always / only when risk warrants / never."
    },
    "council_seats": {
      "group": "deliberation",
      "type": "int",
      "label": "Council seats",
      "doc": "Seated personas per council (shipped: the 4 seats in council_seats.yaml)."
    },
    "council_feature_threshold": {
      "group": "deliberation",
      "type": "int",
      "label": "Council feature threshold",
      "doc": "Feature count above which a build-strategy council convenes."
    },
    "ponder_round1_tokens": {
      "group": "deliberation",
      "type": "int",
      "label": "Ponder budget, round 1",
      "doc": "max_tokens per council seat, round 1 (shipped: councils.py)."
    },
    "ponder_round2_tokens": {
      "group": "deliberation",
      "type": "int",
      "label": "Ponder budget, round 2",
      "doc": "max_tokens per council seat, round 2 / dissent (shipped: councils.py)."
    },
    "delegation_depth": {
      "group": "parallelization",
      "type": "int",
      "label": "Delegation depth",
      "doc": "Sub-agent tree depth. Contract \u00a712 hard-caps runtime at 3."
    },
    "worker_fan_out": {
      "group": "parallelization",
      "type": "int",
      "label": "Worker fan-out",
      "doc": "Max concurrent children per node. 0 = uncapped (shipped: no cap exists)."
    },
    "multi_doc_parallel": {
      "group": "parallelization",
      "type": "bool",
      "label": "Parallel multi-doc parts",
      "doc": "Allow parallel work on multiple documents via T-W16 doc leases."
    },
    "preflight": {
      "group": "safety",
      "type": "bool",
      "label": "Preflight checks",
      "doc": "\u00a710 preflight before mutating tool calls."
    },
    "overseer_cadence": {
      "group": "safety",
      "type": "enum",
      "choices": [
        "every_trigger",
        "stage_exit_only",
        "manual_only"
      ],
      "label": "Overseer audit cadence",
      "doc": "\u00a711 audit trigger points honoured (shipped: all, debounced)."
    },
    "failure_max_attempts": {
      "group": "safety",
      "type": "int_map",
      "label": "Failure-card attempt budgets",
      "doc": "Per failure class max fixer attempts (shipped: advisor/failures.py)."
    },
    "history_budget_tokens": {
      "group": "context",
      "type": "int",
      "label": "History budget",
      "doc": "Per-turn history slot tokens (shipped: tiers.yaml budgets.history)."
    },
    "trigger_injection": {
      "group": "context",
      "type": "bool",
      "label": "Trigger injection",
      "doc": "\u00a720 domain trigger packs (threads, bearing fits, ...)."
    },
    "trigger_cooldown_scale": {
      "group": "context",
      "type": "float",
      "label": "Trigger cooldown scale",
      "doc": "Multiplier on per-trigger cooldown_turns. 1.0 = shipped cadence."
    },
    "context_pack_verbosity": {
      "group": "context",
      "type": "enum",
      "choices": [
        "full",
        "compact"
      ],
      "label": "Context-pack verbosity",
      "doc": "Advisory/context-pack rendering (shipped: tiers.yaml advisory_verbosity)."
    }
  },
  "tiers": {
    "local-24k": {
      "tier": "local-24k",
      "level": "standard",
      "values": {
        "deliberation": "full",
        "ladder": "mandatory",
