// STM32F4 Discovery platform description for Renode (MIT)
// Source: based on Renode's STM32F4 platform files (https://github.com/renode/renode-infrastructure)
// License: MIT — see templates/renode_platforms/LICENSE
//
// T-C5 fix: the inline `PeripheralPort: sysbus new Bus.BusPointRegistration { ... }` + `init:
// RegisterFPUInterruptNumber` block is not valid Renode .repl syntax for CPU.CortexM in this
// Renode version — `machine LoadPlatformDescription` failed with a parser error right at `new`
// ("expected attribute list end"), confirmed live. Never actually loaded in Renode before T-C5
// (T-C3's tests mock the subprocess). Replaced with the real, working NVIC + cpu wiring from
// Renode's own bundled platforms/cpus/stm32f4.repl (IRQ number 37 for USART1 matches the real
// STM32F407 vector table, same as upstream).

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 72000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

usart1: UART.STM32_UART @ sysbus <0x40011000, +0x100>
    -> nvic@37

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

// T-FIN1: GPIO ports A–E so pin-level assertions have a peripheral to observe.
// Model + register map from Renode's own platforms/cpus/stm32f4.repl (MIT):
// STM32F4GPIOPort at 0x40020000 + 0x400*port, mode/PUPD reset values per RM0090.
// [~] live-verify: hook wiring (`AddStateChangedHook`) + ODR reads exercised by the
// generated .resc; canned-output parser tests cover the extraction path.
gpioPortA: GPIOPort.STM32F4GPIOPort @ sysbus <0x40020000, +0x400>
    modeResetValue: 0xA8000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32F4GPIOPort @ sysbus <0x40020400, +0x400>
    modeResetValue: 0x00000280
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16

gpioPortC: GPIOPort.STM32F4GPIOPort @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16

gpioPortD: GPIOPort.STM32F4GPIOPort @ sysbus <0x40020C00, +0x400>
    numberOfAFs: 16

gpioPortE: GPIOPort.STM32F4GPIOPort @ sysbus <0x40021000, +0x400>
    numberOfAFs: 16

// T-FIN2: peripheral pack — stanzas copied from Renode's own platforms/cpus/stm32f4.repl
// (https://github.com/renode/renode/blob/master/platforms/cpus/stm32f4.repl, MIT).
// Local changes vs upstream: DMA request links dropped (this curated platform declares
// no DMA controller) and the rcc->timer9 reset link dropped (no RCC model here).
// No ADC: upstream stm32f4.repl ships no ADC model — capability is reported honestly
// as adc=false in platform_db. [~] live-verify: renode absent on this machine.

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ->nvic@35

spi2: SPI.STM32SPI @ sysbus 0x40003800
    IRQ->nvic@36

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    IRQ->nvic@51

i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

i2c3: I2C.STM32F1_I2C @ sysbus 0x40005C00
    EventInterrupt -> nvic@72
    ErrorInterrupt -> nvic@73

timer1: Timers.STM32_Timer @ sysbus 0x40010000
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[26, 26]
    CaptureCompareInterrupt -> nvic@27
    frequency: 10000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    -> nvic@29
    frequency: 10000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    -> nvic@30
    frequency: 10000000
    initialLimit: 0xFFFF

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    -> nvic@50
    frequency: 10000000
    initialLimit: 0xFFFFFFFF
