// Windows resource script for AI-CAD.
// Embeds the application icon (shown by File Explorer + the taskbar) and the
// version/details metadata into AI-CAD.exe. Wired into the build by
// host/CMakeLists.txt (WIN32-only). The .ico is generated by
// host/assets/make_logo.py (make_ico -> assets/app.ico).

#include <winver.h>

// The lowest-numbered ICON resource is what Explorer uses for the .exe.
1 ICON "assets/app.ico"
// Second icon group: the branded DOCUMENT icon. File associations point their
// DefaultIcon at "<exe>,1" (zero-based icon-group index -> this group), so
// .step+ etc. show the doc page icon while the exe keeps the app tile above.
2 ICON "assets/doc.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AI-CAD"
            VALUE "FileDescription",  "AI-CAD"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AI-CAD"
            VALUE "OriginalFilename", "AI-CAD.exe"
            VALUE "ProductName",      "AI-CAD"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
