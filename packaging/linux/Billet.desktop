[Desktop Entry]
Type=Application
Name=Billet
Comment=AI-native parametric CAD
Exec=Billet %F
Icon=Billet
Categories=Graphics;Engineering;
Terminal=false
# Must match the window class set via glfwWindowHintString(GLFW_X11_CLASS_NAME/…) in
# host/src/app.cpp so the shell binds the live window to this entry (taskbar icon).
StartupWMClass=Billet
X-BinaryName=Billet
# NOTE: binary is built from host/ — cmake -S host -B host/build-linux + ninja Billet.
# In the AppImage this is staged to usr/bin/Billet and launched via AppRun.
# For system installs, install host/build-linux/bin/Billet to a PATH directory.
# ui/imgui (AI-CAD2) is retired; host/ is the single cross-platform GUI (see docs/PORT_LEDGER.md).
# BRANDING NOTE: the binary is now Billet (2026-07 deep rename); an AI-CAD compat
# symlink ships beside it in the build dir for legacy scripts/harnesses.
