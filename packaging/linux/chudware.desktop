[Desktop Entry]
Type=Application
Name=Chudware
Comment=Chudware — AI-native parametric CAD
Exec=chudware %F
Icon=Billet
Categories=Graphics;Engineering;
Terminal=false
# Must match the window class set via glfwWindowHintString(GLFW_X11_CLASS_NAME/…) in
# host/src/app.cpp so the shell binds the live window to this entry (taskbar icon).
# WM_CLASS is "chudware" (internal plumbing, matches the display brand) — do NOT
# change this without also changing the glfwWindowHintString calls in app.cpp,
# or the taskbar icon binding breaks.
StartupWMClass=chudware
X-BinaryName=chudware
# NOTE: binary is built from host/ — cmake -S host -B host/build-linux + ninja -C host/build-linux Billet (target name unchanged; output file is chudware).
# In the AppImage this is staged to usr/bin/chudware and launched via AppRun.
# For system installs, install host/build-linux/bin/chudware to a PATH directory.
# ui/imgui (AI-CAD2) is retired; host/ is the single cross-platform GUI (see docs/PORT_LEDGER.md).
# BRANDING NOTE: the binary is now chudware (2026-07 deep rename); a Billet compat
# symlink ships beside it in the build dir for legacy scripts/harnesses.
