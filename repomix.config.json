{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "topFilesLength": 20
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/build*/**",
      "build/**",
      "dist/**",
      "**/node_modules/**",
      "vendor/omp/**",
      "extern/**",
      "third_party/**",
      "**/third_party/**",
      "core/third_party/**",
      "graphify-out/**",
      "scratch/**",
      ".venv-mcp/**",
      ".pip-cache/**",
      ".pytest_cache/**",
      ".aicadvault/**",
      ".git/**",
      ".omp/**",
      ".claude/**",
      "services/dist/**",
      "services/corpora/**",
      "benchmarks/simsuite/results/**",
      "tools/flywheel/bench/gym/reports/**",
      "docs/contracts/fixtures/runs/**",
      "**/ledger.json",
      "docs/cam_samples/**",
      "tools/gsl_gnn/ranker_weights.json",
      "reports/profiling/**",
      "Webservice/image/**",
      "Webservice/gateway/**",
      "assets/icons/**",
      "assets/fonts/**",
      "assets/__pycache__/**",
      "**/__pycache__/**",
      "work/sync/**",
      ".worksync/**",
      "signal-desktop*",
      "repomix-output.*",
      "*.step",
      "*.stp",
      "*.step+",
      "*.AppImage",
      "*.zip",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.icns",
      "*.svg",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.otf",
      "*.gpg",
      "*.obj",
      "*.bin",
      "*.so",
      "*.a",
      "*.o",
      "preflight_events.jsonl",
      "1"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
