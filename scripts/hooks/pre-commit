#!/bin/sh
# AI-CAD pre-commit gate — runs the deterministic source-level standards checks (gui_lint,
# feature_surface_audit, parity_audit). Stdlib-only, ~1s; does NOT run the pytest suites.
#
# Install:  cp scripts/hooks/pre-commit .git/hooks/pre-commit   (or: git config core.hooksPath scripts/hooks)
#
# Pick a python: prefer the dev venv if present, else PATH python.
PY="$APPDATA/AI-CAD/runtime/venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

"$PY" scripts/check.py || {
    echo ""
    echo "pre-commit: standards gate FAILED — fix the findings above, or commit with --no-verify to bypass."
    exit 1
}
