#!/bin/sh
# Pre-commit gate: runs the deterministic source-level standards checks (scripts/check.py:
# gui_lint, feature_surface_audit, parity_audit, ...). About a second; does NOT run the
# pytest suites.
#
# Install:  git config core.hooksPath scripts/hooks   (or copy this file to .git/hooks/)
#
# Prefer the development venv (scripts/provision_venv.sh), else python3 on PATH.
PY=".venv-mcp/bin/python"
[ -x "$PY" ] || PY=".venv-mcp/Scripts/python.exe"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

"$PY" scripts/check.py || {
    echo ""
    echo "pre-commit: standards gate FAILED — fix the findings above, or commit with --no-verify to bypass."
    exit 1
}
