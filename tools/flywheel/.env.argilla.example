# Copy to .env.argilla and fill in real values before running docker-compose.
# DO NOT commit .env.argilla — it is in .gitignore.

# Argilla API key for the admin user
ARGILLA_API_KEY=argilla.apikey

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ARGILLA_AUTH_SECRET_KEY=changeme-generate-a-real-secret

# These are consumed by argilla_loader.py when ARGILLA_API_URL / ARGILLA_API_KEY env vars are set
# ARGILLA_API_URL=http://localhost:6900
