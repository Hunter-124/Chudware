+/**
+ * SQLite's "database disk image is malformed" result code (`SQLITE_CORRUPT`,
+ * extended code 11) plus the "file is not a database" result code
+ * (`SQLITE_NOTADB`, extended code 26 — the file lacks a valid SQLite header,
+ * e.g. after truncation). Unlike busy errors the file cannot be worked around
+ * by retrying the same statement — the caller must quarantine the file and
+ * open (or recreate) a fresh database.
+ */
+export function isSqliteCorruptError(err: unknown): boolean {
+	if (err === null || typeof err !== "object") return false;
+	const code = (err as { code?: unknown }).code;
+	return typeof code === "string" && (code.startsWith("SQLITE_CORRUPT") || code === "SQLITE_NOTADB");
+}
