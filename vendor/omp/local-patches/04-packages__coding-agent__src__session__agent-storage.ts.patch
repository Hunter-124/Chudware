+/**
+ * Move a corrupted database file (and any WAL/SHM companions) aside so the next
+ * open recreates a fresh one. Returns false when the main database file cannot
+ * be moved — callers must then propagate the original error.
+ */
+function quarantineCorruptAgentDb(dbPath: string): boolean {
+	const stamp = `corrupt-${Date.now()}`;
+	let movedMain = false;
+	for (const file of [dbPath, `${dbPath}-wal`, `${dbPath}-shm`]) {
+		try {
+			if (!fs.existsSync(file)) continue;
+			fs.renameSync(file, `${file}.${stamp}`);
+			if (file === dbPath) movedMain = true;
+		} catch (err) {
+			logger.warn("AgentStorage failed to quarantine corrupted db file", {
+				path: file,
+				error: err instanceof Error ? err.message : String(err),
+			});
+			return movedMain;
+		}
+	}
+	return movedMain;
+}
