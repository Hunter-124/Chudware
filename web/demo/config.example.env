# Chudware public demo front door: configuration template.
# deploy/install.sh copies this to /etc/chudware-demo/demo.env (mode 0600, owner
# chudware-demo) ONLY if that file does not exist, and fills in a fresh cookie key.
# This repository copy never holds a secret; put real values in the installed file.
# Unset or blank values fall back to the defaults shown in comments.

# --- secrets (installed file only) -------------------------------------------------
# The owner's OpenRouter key. Read by the front door process alone; it never enters a
# session container. Without it the AI lane answers 503 ai_unavailable and everything
# else still works.
CHUDWARE_DEMO_OPENROUTER_KEY=
# HMAC key for the anonymous session cookie, at least 32 characters. Keep it stable:
# an unset key is regenerated at every start, which signs every visitor out and stops
# sessions from being adopted after a restart.
CHUDWARE_DEMO_COOKIE_KEY=
# The owner's Claude API key (use a dedicated Console workspace with a monthly spend
# limit). Read by the front door alone. Without it the Claude lane answers 503
# ai_unavailable and the free models still work.
CHUDWARE_DEMO_ANTHROPIC_KEY=
# The owner's NVIDIA API key (build.nvidia.com, free). Read by the front door alone. With
# it the Nemotron models are served by NVIDIA's API instead of OpenRouter.
CHUDWARE_DEMO_NVIDIA_KEY=

# --- image (pulled ahead of time by install.sh; sessions never pull) ---------------
CHUDWARE_DEMO_IMAGE_TAG=edge
# CHUDWARE_DEMO_IMAGE_REPO=ghcr.io/hunter-124/chudware-web

# --- public surface ------------------------------------------------------------------
# Host names the front door answers to (Host header allowlist).
# CHUDWARE_DEMO_PUBLIC_HOSTS=app.chudware.com,localhost,127.0.0.1

# --- admission and limits (defaults) -------------------------------------------------
# CHUDWARE_DEMO_MAX_ACTIVE=3
# CHUDWARE_DEMO_MAX_QUEUE=30
# CHUDWARE_DEMO_IDLE_SECONDS=900
# CHUDWARE_DEMO_HARD_SECONDS=2700
# CHUDWARE_DEMO_WARN_SECONDS=300
# CHUDWARE_DEMO_QUEUE_POLL_TIMEOUT=60
# CHUDWARE_DEMO_START_TIMEOUT=90
# Joins allowed per client network in the window below.
# CHUDWARE_DEMO_JOIN_LIMIT=6
# CHUDWARE_DEMO_JOIN_WINDOW=600
# Refuse to admit when host MemAvailable or free disk (podman storage) is below these.
# CHUDWARE_DEMO_MIN_MEM_GIB=4
# CHUDWARE_DEMO_MIN_DISK_GIB=3

# --- AI lane (free OpenRouter models only: every entry must end in :free) ----------
# Free models carry no demo quota. OpenRouter itself allows an account without purchased
# credits 50 free-model requests per UTC day; NVIDIA's free API has no daily cap, only a
# per-minute rate, so with an NVIDIA key (CHUDWARE_DEMO_NVIDIA_KEY above) the Nemotron
# models go there.
# CHUDWARE_DEMO_NVIDIA_BASE=https://integrate.api.nvidia.com/v1
# CHUDWARE_DEMO_AI_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free
# Per-request output cap applied to every forwarded request.
# CHUDWARE_DEMO_AI_MAX_OUTPUT_TOKENS=16384

# --- Claude lane (owner's Claude API key; USD caps enforced before forwarding) ------
# CHUDWARE_DEMO_ANTHROPIC_BASE=https://api.anthropic.com
# Only these ids are accepted; anything else (Fable, Mythos, ...) refuses to start.
# CHUDWARE_DEMO_CLAUDE_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
# Per session.
# CHUDWARE_DEMO_CLAUDE_SESSION_USD=10
# Per client network per UTC day.
# CHUDWARE_DEMO_CLAUDE_CLIENT_DAILY_USD=10
# All sessions per UTC day, and per UTC calendar month.
# CHUDWARE_DEMO_CLAUDE_DAILY_USD=30
# CHUDWARE_DEMO_CLAUDE_MONTHLY_USD=99
# Per-request max_tokens cap (a thinking budget is clamped below it).
# CHUDWARE_DEMO_CLAUDE_MAX_OUTPUT_TOKENS=32000

# --- session containers (defaults) ---------------------------------------------------
# CHUDWARE_DEMO_CPUS=2
# CHUDWARE_DEMO_MEMORY=3500m
# CHUDWARE_DEMO_PIDS_LIMIT=512
# CHUDWARE_DEMO_TMPFS_DATA=256m
# CHUDWARE_DEMO_TMPFS_WORK=1g
# CHUDWARE_DEMO_TMPFS_STATE=1g
# CHUDWARE_DEMO_TMPFS_RUN=64m
# CHUDWARE_DEMO_TMPFS_TMP=512m
# Loopback ports published for session containers: PORT_BASE .. PORT_BASE+PORT_COUNT-1.
# CHUDWARE_DEMO_PORT_BASE=18300
# CHUDWARE_DEMO_PORT_COUNT=64
# Extra pasta options (comma separated). Default: none (plain `--network pasta`).
# CHUDWARE_DEMO_PASTA_OPTIONS=
# Extra `--security-opt` values, e.g. for an AppArmor host: apparmor=chudware-selfhost
# (seccomp and privileged entries are refused).
# CHUDWARE_DEMO_EXTRA_SECURITY_OPTS=
