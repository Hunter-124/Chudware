#!/usr/bin/python3 -IS
import os
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from cell_runtime import BASE_ENV, actor_environment, close_extra_fds

BOOTSTRAP = ('import runpy,sys; sys.path.insert(0,"/opt/chudware"); '
             'sys.argv[0]="chudware-worker"; '
             'runpy.run_module("services.compiled_entry", run_name="__main__", alter_sys=True)')
WORKER_ENV = frozenset({"HOME", "XDG_DATA_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_RUNTIME_DIR",
    "CHUDWARE_ACTOR_SANDBOX", "CHUDWARE_ACTOR_STATE", "CHUDWARE_HOSTD_SOCKET",
    "PI_CODING_AGENT_DIR", "PI_PACKAGE_DIR", "SSL_CERT_FILE"})


def worker_argv(arguments):
    if os.environ.get("CHUDWARE_CELL") != "1":
        raise ValueError("worker bootstrap requires a cell")
    environment = {**BASE_ENV, **actor_environment(), **{key: os.environ[key] for key in WORKER_ENV if key in os.environ},
        "CHUDWARE_WORKER_PYTHON": "/opt/chudware/venv/bin/python",
        "CHUDWARE_CHUDCODE_BIN": "/opt/chudware/bin/chud"}
    executable = "/opt/chudware/venv/bin/python"
    return executable, [executable, "-I", "-c", BOOTSTRAP, *arguments], environment


if __name__ == "__main__":
    try:
        executable, arguments, environment = worker_argv(sys.argv[1:])
        close_extra_fds()
        os.execve(executable, arguments, environment)
    except Exception as exc:
        print("cell_refused: " + str(exc), file=sys.stderr)
        sys.exit(1)
