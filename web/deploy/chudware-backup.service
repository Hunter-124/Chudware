[Unit]
Description=chudware-web environment-scoped encrypted database and storage backup

[Service]
Type=oneshot
EnvironmentFile=%h/.config/chudware/backup.env
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
ExecStart=%h/Repositories/CAD/Webservice/deploy/backup.sh
Nice=15
IOSchedulingClass=idle
