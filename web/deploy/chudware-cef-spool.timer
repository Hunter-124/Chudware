[Unit]
Description=Hourly Chudware CEF metrics spool bound

[Timer]
# Hourly, not daily. The leak measured 650 MB/day on a disk with single-digit
# gigabytes free, and the daemon that produces it can run for weeks without a
# restart, so the host's own startup reaper may never get a turn. An hour also
# matches cef_spool_reaper.MAX_AGE_SECONDS, so steady state is at most one
# hour's worth of spool rather than one day's.
OnCalendar=hourly
RandomizedDelaySec=5m
Persistent=true
Unit=chudware-cef-spool.service

[Install]
WantedBy=timers.target
