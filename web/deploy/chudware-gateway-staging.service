[Unit]
Description=chudware-web staging gateway (FastAPI / uvicorn on 127.0.0.1:8310)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

# Install in the dedicated chudware-staging account's user manager, never production's.
ConditionUser=chudware-staging

[Service]
Type=simple
WorkingDirectory=%h/Repositories/CAD/Webservice/gateway
EnvironmentFile=%h/chudware-web-staging/gateway.env
EnvironmentFile=-%h/chudware-web-staging/webd.env
Environment=CHUDWARE_WEB_DATA=%h/chudware-web-staging
Environment=CHUDWARE_WEB_DATA_ROOT=%h/chudware-web-staging
Environment=CHUDWARE_WEBD_ENV=%h/chudware-web-staging/webd.env
Environment=CHUDWARE_WORKSPACE_ROOT=%h/chudware-web-staging/workspace
Environment=CHUDWARE_WEB_BUCKET_ROOT=%h/chudware-web-staging/bucket
Environment=CHUDWARE_WEB_APP_DIR=%h/chudware-web-staging/app
Environment=CHUDWARE_RELEASES_DIR=%h/chudware-web-staging/customer-releases
Environment=CHUDWARE_RELEASES_BUCKET=chudware-releases-staging
Environment=CHUDWARE_RELEASES_PUBLIC_BASE_URL=https://staging.chudware.com
Environment=CHUDWARE_WEB_TERMINAL_ENABLED=0
# config.py reads CHUDWARE_WEB_PUBLIC_BASE_URL; the shorter spelling was dead,
# so staging built its verification, reset, and OAuth redirect URLs for the
# production apex instead of itself.
Environment=CHUDWARE_WEB_PUBLIC_BASE_URL=https://staging.chudware.com
Environment=CHUDWARE_DEPLOY_ENV=staging
Environment=CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304
LoadCredentialEncrypted=entitlement.key:%h/.config/credstore.encrypted/chudware-entitlement-staging.cred
Environment=CHUDWARE_ENTITLEMENT_KEY_PATH=%d/entitlement.key
ExecStartPre=/usr/bin/bash -c 'test "$CHUDWARE_DEPLOY_ENV" = staging && test "$HOME" = /var/lib/chudware-staging && test "$CHUDWARE_WEB_DATA_ROOT" = "$HOME/chudware-web-staging"'
ExecStartPre=%h/Repositories/CAD/Webservice/gateway/.venv/bin/python %h/Repositories/CAD/Webservice/deploy/gateway_preflight.py validate --env-file %h/chudware-web-staging/gateway.env --environment staging
ExecStart=%h/Repositories/CAD/Webservice/gateway/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8310 --proxy-headers --forwarded-allow-ips=127.0.0.1 --ws-max-size ${CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES} --no-access-log
Restart=on-failure
RestartSec=3
MemoryMax=1G
MemoryHigh=900M
TasksMax=256
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=%h/chudware-web-staging
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077


[Install]
WantedBy=default.target
