# Chudware web gateway (systemd user unit). install_cells.sh substitutes
# @REPO@, @WEB_HOME@ and @WORKSPACE@. Optional settings (see
# web/gateway/config.example.env) go in ~/.config/chudware/gateway.env.
[Unit]
Description=Chudware web gateway (uvicorn on 127.0.0.1:8300)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@/web/gateway
Environment=CHUDWARE_WEB_HOME=@WEB_HOME@
Environment=CHUDWARE_WORKSPACE_ROOT=@WORKSPACE@
# Keep uvicorn's WebSocket frame ceiling identical to the gateway forwarding
# budget. The env file overrides this default when the operator tunes it.
Environment=CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304
EnvironmentFile=-%h/.config/chudware/gateway.env
ExecStart=@REPO@/web/gateway/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8300 --ws-max-size ${CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES} --no-access-log
Restart=on-failure
RestartSec=3
MemoryMax=1G
MemoryHigh=900M
TasksMax=256
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# The gateway writes cell metadata under the web home and workspace files.
ReadWritePaths=@WEB_HOME@ @WORKSPACE@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
