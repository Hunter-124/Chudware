[Unit]
Description=chudware-web host monitor (RAM/disk/GPU, disk-pressure flag)
Documentation=file://%h/Repositories/CAD/Webservice/deploy/RUNBOOK.md
After=network.target

[Service]
Type=oneshot
Environment=CHUDWARE_WEB_DATA=%h/chudware-web-data
Environment=CHUDWARE_GATEWAY_HEALTHZ=http://127.0.0.1:8300/healthz
ExecStart=/usr/bin/python3 %h/Repositories/CAD/Webservice/deploy/monitor.py
Nice=10

# No Install section — driven by chudware-monitor.timer
