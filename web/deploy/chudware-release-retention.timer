[Unit]
Description=Daily chudware-web release artifact retention

[Timer]
# 05:15, an hour after security retention, so the two are not competing for the
# same idle-priority IO on a box that is also serving downloads.
OnCalendar=*-*-* 05:15:00
RandomizedDelaySec=15m
# A host that was powered off through the scheduled time still runs once it is
# back: the pile this bounds keeps growing while the machine is down.
Persistent=true
Unit=chudware-release-retention.service

[Install]
WantedBy=timers.target
