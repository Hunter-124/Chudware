[Unit]
Description=chudware-web staging expired security event retention
After=network-online.target
ConditionUser=chudware-staging

[Service]
Type=oneshot
EnvironmentFile=%h/chudware-web-staging/gateway.env
Environment=CHUDWARE_WEB_DATA=%h/chudware-web-staging
Environment=CHUDWARE_WEB_DATA_ROOT=%h/chudware-web-staging
Environment=CHUDWARE_DEPLOY_ENV=staging
WorkingDirectory=%h/Repositories/CAD/Webservice/gateway
ExecStart=/usr/bin/env CHUDWARE_DEPLOY_ENV=staging %h/Repositories/CAD/Webservice/gateway/.venv/bin/python %h/Repositories/CAD/Webservice/deploy/security_retention.py
Nice=15
IOSchedulingClass=idle
