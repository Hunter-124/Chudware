# Chudware web gateway settings. Copy to a gitignored env file and load it with
# your process manager (for example the systemd unit's EnvironmentFile=).
# Every value below is optional; the defaults are shown.

# The single local operator. Every request acts as this identity; it names the
# workspace and engine cell and is not a credential. Letters, digits, _ and -.
# CHUDWARE_WEB_OPERATOR=operator

# Host header values the gateway answers to (comma separated, ports ignored).
# Add the public hostname when serving through a reverse proxy, and have the
# proxy forward the original Host header.
# CHUDWARE_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Install root shared with web/deploy/install_cells.sh. Engine cells live in
# <home>/cells and the cell payload in <home>/current.
# CHUDWARE_WEB_HOME=~/.local/share/chudware-web

# The operator's CAD files (mounted as /work inside the engine cell).
# CHUDWARE_WORKSPACE_ROOT=<home>/workspace

# WASM client bundle served at /app; ./build.sh wasm stages it here.
# CHUDWARE_WEB_APP=<repo>/host/build-wasm/app

# Largest accepted workspace upload, in bytes.
# CHUDWARE_WEB_MAX_UPLOAD_BYTES=104857600

# Largest /engine WebSocket frame forwarded in either direction, in bytes. Pass
# the same value to uvicorn's --ws-max-size.
# CHUDWARE_WEB_WS_MAX_MESSAGE_BYTES=4194304

# Concurrent /engine connections (one per open browser tab).
# CHUDWARE_WEB_MAX_ENGINE_BRIDGES=4
