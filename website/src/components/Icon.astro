---
/**
 * Canonical Chudware icon set: 24×24 path data held once for the whole site.
 * Line icons render with the shared stroke attributes; the three OS marks render solid.
 *
 * Icons are decorative: every instance is `aria-hidden="true"` and the
 * adjacent text carries the meaning. An icon-only control puts `aria-label`
 * on the control itself, not here.
 */
interface Props {
  name: string;
  class?: string;
}

