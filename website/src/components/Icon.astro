const { name, class: className } = Astro.props;
const line = LINE[name];
const solid = SOLID[name];
if (!line && !solid) throw new Error(`Icon "${name}" is not in the canonical set`);
---
{line ? (
  <svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={line}
  />
) : (
  <svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" set:html={solid} />
)}
