---
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
// "Chudware documentation · Chudware" reads as a mistake in a search result.
const fullTitle = /\bChudware\b/.test(title) ? title : `${title} · Chudware`;
const canonical = new URL(path, Astro.site).href;
// Link previews (Slack, LinkedIn, X, iMessage) show this; a real product capture
// says more than a logo card.
const shareImage = new URL('/images/modeling.png', Astro.site).href;
// Organization gives Search the logo; WebSite gives it the site name; the
// SoftwareApplication entry describes the product itself. Google reads all three
// from the home page only.
const GITHUB = 'https://github.com/Hunter-124/Chudware';
const structuredData = path === '/' ? JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${Astro.site}#organization`,
    name: 'Chudware',
    url: `${Astro.site}`,
    logo: new URL('/icon-512.png', Astro.site).href,
    sameAs: [GITHUB],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Chudware',
    url: `${Astro.site}`,
    publisher: { '@id': `${Astro.site}#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Chudware',
    url: `${Astro.site}`,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Windows, Linux, macOS',
    license: 'https://opensource.org/license/mit',
    publisher: { '@id': `${Astro.site}#organization` },
  },
]) : null;
const nav = [
  { href: '/product/', label: 'Product' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/docs/', label: 'Docs' },
  { href: '/open-source/', label: 'Open source' },
  { href: '/about/', label: 'About' },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111310" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chudware" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content="The Chudware modeling workspace: a parametric part beside its feature tree and the copilot" />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand tap" href="/" aria-label="Chudware home">
          <img src="/assets/logo.svg" width="32" height="32" alt="" />
          <span>CHUDWARE</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          {nav.map((item) => <a class="tap" href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="header-link tap" href="/docs/self-hosting/">Self-host</a>
          <a class="button button-small" href="/download/">Get started</a>
        </div>
        <details class="mobile-nav">
          <summary class="tap"><Icon name="menu" /><span>Menu</span></summary>
          <nav aria-label="Mobile primary">
            {nav.map((item) => <a class="tap" href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
            <a class="tap" href="/docs/self-hosting/">Self-host</a>
            <a class="tap mobile-download" href="/download/">Get started</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a class="brand tap" href="/"><img src="/assets/logo.svg" width="28" height="28" alt="" /><span>CHUDWARE</span></a>
          <p>AI-first CAD for engineers. Exact solids, dimension-driven models, and a team of agents collaborating across your workspace. MIT-licensed software, free to run yourself; optional paid hosting supports the project.</p>
        </div>
        <nav aria-label="Capability links">
          <strong>Capabilities</strong>
          <a class="tap" href="/product/modeling/">Modeling</a><a class="tap" href="/product/assemblies/">Assemblies</a><a class="tap" href="/product/simulation/">Simulation</a><a class="tap" href="/product/polymesh/">PolyMesh FEA</a><a class="tap" href="/product/cam/">CAM</a><a class="tap" href="/product/plm/">PLM</a><a class="tap" href="/product/copilot/">AI copilot</a><a class="tap" href="/product/reverse-engineering/">Reverse engineering</a>
        </nav>
        <nav aria-label="Explore links">
          <strong>Explore</strong>
          <a class="tap" href="/product/">Overview</a><a class="tap" href="/gallery/">Gallery</a><a class="tap" href="/download/">Get started</a><a class="tap" href="/docs/">Docs</a><a class="tap" href="/faq/">FAQ</a><a class="tap" href="/changelog/">Changelog</a>
        </nav>
        <nav aria-label="Project links">
          <strong>Project</strong>
          <a class="tap" href="/about/">About</a><a class="tap" href="/open-source/">Source and licenses</a><a class="tap" href="/docs/self-hosting/">Self-hosting</a><a class="tap" href="/contact/">Hosting inquiries</a><a class="tap" href="/contact/">Contact and security</a><a class="tap" href="/legal/privacy/">Privacy</a>
        </nav>
      </div>
      <div class="wrap footer-bottom"><span>© 2026 Hunter Edmonds and Chudware contributors</span><span>Public MIT-licensed source.</span></div>
    </footer>

  </body>
</html>
