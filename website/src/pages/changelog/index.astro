---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
const releases = (await getCollection('changelog')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const date = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Changelog" description="Chudware project updates, licensing, and deployment notes; publication status is stated separately from build configuration.">
  <header class="page-hero"><div class="wrap"><p class="eyebrow">Changelog</p><h1>What changed, and why it matters.</h1><p class="lede">Project announcements and deployment notes. Public desktop installers are not yet available; see <a class="text-link" href="/download/">current setup choices</a> or <a class="text-link" href="/docs/self-hosting/">self-hosting instructions</a>.</p></div></header>
  <section class="section"><div class="wrap release-list">{releases.map((release) => <article class="panel release-card"><p class="release-meta">{release.data.version} · {date.format(release.data.published)}</p><h2>{release.data.title}</h2><p class="lede">{release.data.description}</p><a class="text-link" href={`/changelog/${release.id}/`}>Read release notes <Icon name="arrow-right" /></a></article>)}</div></section>
</BaseLayout>
