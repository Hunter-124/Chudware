---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/download.css';

const DOWNLOADS = 'https://app.chudware.com/#downloads';
---
<BaseLayout title="Download Chudware" description="Download the Chudware desktop app for Windows, Linux, and macOS, or open the browser workspace.">
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Native desktop</p>
      <h1>Download Chudware.</h1>
      <p class="lede">Signed builds for Windows, Linux, and macOS. Sign in to download the current release for your platform.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <article class="panel dl-primary" id="dl-primary" aria-live="polite">
        <span class="dl-mark" id="dl-primary-mark" aria-hidden="true">
          <span data-os=""><Icon name="download" /></span>
          <span data-os="windows" hidden><Icon name="windows" /></span>
          <span data-os="macos" hidden><Icon name="apple" /></span>
          <span data-os="linux" hidden><Icon name="linux" /></span>
        </span>
        <div class="dl-primary-body">
          <p class="eyebrow" id="dl-primary-eyebrow">Signed release</p>
          <h2 id="dl-primary-title">Chudware desktop</h2>
          <p class="dl-note" id="dl-primary-note">Sign in to your account to download the current build for Windows, Linux, or macOS.</p>
          <p class="release-meta" id="dl-primary-meta"></p>
        </div>
        <a class="button" id="dl-primary-action" href={DOWNLOADS}>Go to the download page</a>
      </article>

      {/* Platform priority set by Hunter (2026-08-27): Windows and Linux are the
          shipping targets and the macOS CI runner is intermittently offline, so
          the cards render Windows, Linux, macOS. macOS stays fully offered — it
          is simply last, never greyed out. The script's PLATFORM_RANK mirrors
          this order for every rendered enumeration. */}
      <div class="dl-grid">
        <article class="panel dl-card">
          <header class="dl-card-head">
            <span class="dl-mark" aria-hidden="true"><span data-os="windows"><Icon name="windows" /></span></span>
            <h3>Windows</h3>
          </header>
          <p>x86-64 package. Version, size, and checksum are shown on the account download page.</p>
          <ul class="dl-builds" data-dl-platform="windows"></ul>
          <a class="text-link" href={DOWNLOADS}>Download for Windows <Icon name="arrow-right" /></a>
        </article>
        <article class="panel dl-card">
          <header class="dl-card-head">
            <span class="dl-mark" aria-hidden="true"><span data-os="linux"><Icon name="linux" /></span></span>
            <h3>Linux</h3>
          </header>
          <p>x86-64 package. Version, size, and checksum are shown on the account download page.</p>
          <ul class="dl-builds" data-dl-platform="linux"></ul>
          <a class="text-link" href={DOWNLOADS}>Download for Linux <Icon name="arrow-right" /></a>
        </article>
        <article class="panel dl-card">
          <header class="dl-card-head">
            <span class="dl-mark" aria-hidden="true"><span data-os="macos"><Icon name="apple" /></span></span>
            <h3>macOS</h3>
          </header>
          <p>x86-64 zip archive. Runs on Intel Macs, and on Apple silicon through Rosetta 2.</p>
          <ul class="dl-builds" data-dl-platform="macos"></ul>
          <a class="text-link" href={DOWNLOADS}>Download for macOS <Icon name="arrow-right" /></a>
        </article>
      </div>
      <p class="supporting-copy dl-sysnote">All desktop builds are 64-bit and need a GPU driver with hardware-accelerated 3D. Without one the app won't start.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="dl-terminal-title">
    <div class="wrap">
      <header class="section-heading">
        <p class="eyebrow">Linux terminal install</p>
        <h2 id="dl-terminal-title">Install from the terminal.</h2>
        <p class="lede">The account download page generates a ready-to-run install command for the current Linux package. The command carries a personal download token tied to your account that expires after 15 minutes.</p>
      </header>
      <div class="actions"><a class="button button-secondary" href={DOWNLOADS}>Open account downloads <Icon name="arrow-right" /></a></div>
      <p class="supporting-copy dl-token-note">Don't share the command — it contains your token.</p>
      {/* Every row is hidden until the release API confirms that format exists
          for linux/x86_64. If the fetch fails, the whole format list remains
          hidden rather than naming a package that may not be published. */}
      <dl class="dl-formats" id="dl-format-list" hidden>
        <div data-dl-format="deb" hidden><dt><Icon name="package" /> .deb</dt><dd>For Debian and Ubuntu; installs with apt and removes cleanly.</dd></div>
        <div data-dl-format="rpm" hidden><dt><Icon name="package" /> .rpm</dt><dd>For Fedora, RHEL, and openSUSE; installs with dnf or zypper.</dd></div>
        <div data-dl-format="default" hidden><dt><Icon name="download" /> AppImage</dt><dd>One portable file with nothing to install; make it executable and run it.</dd></div>
        <div data-dl-format="tar" hidden><dt><Icon name="archive" /> .tar.zst</dt><dd>Plain archive for any distribution; unpack and run from anywhere.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <header class="section-heading">
        <p class="eyebrow">Browser workspace</p>
        <h2>Or skip the install.</h2>
        <p class="lede">The browser workspace is the same product, in a tab. It's the quickest route on a machine where you can't install software.</p>
      </header>
      <div class="pricing-note">
        <p class="eyebrow">One account, both routes</p>
        <p>Modeling, assemblies, CAM, PLM, <a class="text-link" href="/product/simulation/">simulation</a>, reverse engineering, and the copilot, straight from the tab. The account you sign in with is the same one the desktop app activates with.</p>
        <a class="text-link" href="https://app.chudware.com/signup">Create an account <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap section-heading">
      <p class="eyebrow">Get started</p>
      <h2>Install it, or open it in a tab.</h2>
      <p class="lede">Same product, same account, either way.</p>
      <div class="actions"><a class="button" href={DOWNLOADS}>Go to the download page</a><a class="button button-secondary" href="/docs/">Read the install guides</a></div>
    </div>
  </section>
</BaseLayout>

<script>
  const API = 'https://app.chudware.com/api/releases/available?channel=stable';
  const SIGNUP = 'https://app.chudware.com/signup';
  const PLATFORM_LABELS: Record<string, string> = { windows: 'Windows', macos: 'macOS', linux: 'Linux' };
  // Platform priority set by Hunter (2026-08-27): Windows and Linux are the
  // shipping targets and the macOS CI runner is intermittently offline, so
  // every enumeration sorts Windows, Linux, macOS — macOS stays fully
  // offered, just last.
  const PLATFORM_RANK: Record<string, number> = { windows: 0, linux: 1, macos: 2 };
  const FORMAT_LABELS: Record<string, Record<string, string>> = {
    windows: { msi: 'Installer (.msi)', default: 'Setup (.exe)' },
    macos: { default: '.zip' },
    linux: { default: 'AppImage', deb: '.deb', rpm: '.rpm', tar: '.tar.zst' },
  };
  // Format order within a platform mirrors the portal: Installer (.msi)
  // before Setup (.exe) on Windows; .deb, .rpm, AppImage, .tar.zst on Linux.
  const FORMAT_RANK: Record<string, Record<string, number>> = {
    windows: { msi: 0, default: 1 },
    linux: { deb: 0, rpm: 1, default: 2, tar: 3 },
  };
  // One plain line per Windows format. Rendered only for formats the API
  // actually returned — never as static copy for an unpublished build.
  const FORMAT_NOTES: Record<string, Record<string, string>> = {
    windows: {
      msi: 'For managed and scripted deployment — Group Policy, Intune, msiexec.',
      default: 'For an ordinary interactive install.',
    },
  };

  interface Build { platform: string; arch: string; format: string; version: string; size: number }
  interface Detected { platform: string; arch: string }

  const formatLabel = (platform: string, format: string): string =>
    FORMAT_LABELS[platform]?.[format] ?? format;

  const formatRank = (b: Build): number => FORMAT_RANK[b.platform]?.[b.format] ?? 9;

  const sortBuilds = (list: Build[]): Build[] =>
    list.slice().sort((a, b) =>
      (PLATFORM_RANK[a.platform] ?? 9) - (PLATFORM_RANK[b.platform] ?? 9)
      || formatRank(a) - formatRank(b)
      || a.arch.localeCompare(b.arch));

  const archLabel = (platform: string, arch: string): string =>
    platform === 'macos' ? (arch === 'arm64' ? 'Apple silicon' : 'Intel') : arch;

  /** Human-readable size, binary units, one decimal below 10: 1.4 GB, 228 MB, 812 KB. */
  function formatBytes(n: number): string {
    if (!Number.isFinite(n) || n < 0) return '';
    const units = ['bytes', 'KB', 'MB', 'GB', 'TB'];
    let v = n;
    let i = 0;
    while (v >= 1024 && i < units.length - 1) { v /= 1024; i += 1; }
    return `${i > 0 && v < 10 ? v.toFixed(1) : Math.round(v)} ${units[i]}`;
  }

  function normPlatform(value: string | undefined): string | null {
    const s = (value ?? '').toLowerCase();
    if (s.includes('win')) return 'windows';
    if (s.includes('mac')) return 'macos';
    if (s.includes('linux')) return 'linux';
    return null;
  }

  /** Apple-silicon heuristic for browsers that mask the architecture. */
  function macArch(): string {
    if (navigator.maxTouchPoints > 0) return 'arm64';
    try {
      const gl = document.createElement('canvas').getContext('webgl');
      if (gl) {
        const dbg = gl.getExtension('WEBGL_debug_renderer_info');
        const renderer = String(dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER));
        if (renderer.includes('Apple')) return 'arm64';
      }
    } catch { /* fall through to Intel */ }
    return 'x86_64';
  }

  async function detect(): Promise<Detected | null> {
    const uad = (navigator as any).userAgentData;
    if (uad?.getHighEntropyValues) {
      try {
        const h = await uad.getHighEntropyValues(['architecture', 'platform', 'platformVersion']);
        const platform = normPlatform(h.platform ?? uad.platform);
        if (platform) {
          const a = (h.architecture ?? '').toLowerCase();
          const arch = a.includes('arm') ? 'arm64' : a.includes('x86') ? 'x86_64' : platform === 'macos' ? macArch() : 'x86_64';
          return { platform, arch };
        }
      } catch { /* fall back to UA sniffing */ }
    }
    const p = navigator.platform ?? '';
    const ua = navigator.userAgent ?? '';
    const arm = /arm64|aarch64/i.test(ua);
    if (/win/i.test(p) || /Windows NT/.test(ua)) return { platform: 'windows', arch: arm ? 'arm64' : 'x86_64' };
    if (/mac/i.test(p) || /Mac OS X/.test(ua)) return { platform: 'macos', arch: macArch() };
    if (/linux|x11/i.test(p) || /Linux/.test(ua)) return { platform: 'linux', arch: arm ? 'arm64' : 'x86_64' };
    return null;
  }

  function setMark(platform: string | null): void {
    document.querySelectorAll<HTMLElement>('#dl-primary-mark [data-os]').forEach((el) => {
      el.hidden = el.dataset.os !== (platform ?? '');
    });
  }

  function renderPrimary(detected: Detected | null, builds: Build[] | null): void {
    const eyebrow = document.getElementById('dl-primary-eyebrow')!;
    const title = document.getElementById('dl-primary-title')!;
    const note = document.getElementById('dl-primary-note')!;
    const meta = document.getElementById('dl-primary-meta')!;
    const action = document.getElementById('dl-primary-action') as HTMLAnchorElement;
    const card = document.getElementById('dl-primary')!;
    card.dataset.detected = detected ? `${detected.platform}/${detected.arch}` : 'unknown';

    if (!detected) {
      // Do not guess: leave the honest static card, point at the platform list.
      eyebrow.textContent = 'Choose your platform';
      note.textContent = 'Every published build is listed below; each links to the download page in your workspace.';
      return;
    }

    const platformName = PLATFORM_LABELS[detected.platform];
    const detectedLine = `Detected: ${platformName} · ${archLabel(detected.platform, detected.arch)}`;

    if (!builds) {
      // Release metadata unreachable: name the platform but never invent a version.
      eyebrow.textContent = detectedLine;
      title.textContent = `Download for ${platformName}`;
      setMark(detected.platform);
      return;
    }

    const forPlatform = builds.filter((b) => b.platform === detected.platform);
    const exact = forPlatform.filter((b) => b.arch === detected.arch);
    const pick = (list: Build[]) => list.find((b) => b.format === 'default') ?? list[0];

    if (exact.length > 0) {
      const build = pick(exact)!;
      eyebrow.textContent = detectedLine;
      title.textContent = `Download for ${platformName}`;
      meta.textContent = `Version ${build.version} · ${formatBytes(build.size)}`;
      setMark(detected.platform);
      const extras = exact
        .filter((b) => b.format !== build.format)
        .sort((a, b) => formatRank(a) - formatRank(b))
        .map((b) => formatLabel(detected.platform, b.format));
      note.textContent = extras.length > 0
        ? `${formatLabel(detected.platform, build.format)}, or choose ${extras.join(', ')} on the download page.`
        : 'The download page issues the link once you are signed in.';
      return;
    }

    if (forPlatform.length > 0) {
      // Same platform, different architecture: offer it and say why, per the
      // design ruling — no disabled button, no "Unavailable".
      const build = pick(forPlatform)!;
      eyebrow.textContent = detectedLine;
      title.textContent = `Chudware for ${platformName}`;
      meta.textContent = `Version ${build.version} · ${formatBytes(build.size)}`;
      setMark(detected.platform);
      note.textContent = detected.platform === 'macos' && detected.arch === 'arm64'
        ? 'The Apple-silicon build is not published yet. This Intel build runs on Apple silicon through Rosetta 2.'
        : `The ${archLabel(detected.platform, detected.arch)} build is not published yet; this ${archLabel(detected.platform, build.arch)} build is offered instead.`;
      return;
    }

    // Nothing for this platform at all.
    eyebrow.textContent = detectedLine;
    title.textContent = `No build is published for ${platformName} yet`;
    note.textContent = 'Open the browser workspace instead — it is the same application with nothing to install.';
    meta.textContent = '';
    action.href = SIGNUP;
    action.textContent = 'Open the browser workspace';
    card.dataset.state = 'fallback';
  }

  function renderGrid(builds: Build[]): void {
    document.querySelectorAll<HTMLUListElement>('[data-dl-platform]').forEach((list) => {
      const platform = list.dataset.dlPlatform!;
      // Rows come from the API response only: a build that was not returned
      // does not get a row.
      for (const build of builds.filter((b) => b.platform === platform)) {
        const li = document.createElement('li');
        const what = document.createElement('span');
        what.textContent = `${formatLabel(platform, build.format)} · ${archLabel(platform, build.arch)}`;
        const detail = document.createElement('span');
        detail.textContent = `${build.version} · ${formatBytes(build.size)}`;
        li.append(what, detail);
        const noteText = FORMAT_NOTES[platform]?.[build.format];
        if (noteText) {
          const noteLine = document.createElement('span');
          noteLine.className = 'dl-build-note';
          noteLine.textContent = noteText;
          li.append(noteLine);
        }
        list.append(li);
      }
    });
  }

  // The format explainers are static markup for the icons' sake, but each row
  // stays hidden until the API confirms that format is actually published for
  // linux/x86_64. Fetch failed → the whole list stays hidden and the section
  // names no formats at all.
  function renderFormats(builds: Build[]): void {
    const list = document.getElementById('dl-format-list')!;
    const present = new Set(
      builds.filter((b) => b.platform === 'linux' && b.arch === 'x86_64').map((b) => b.format),
    );
    let any = false;
    list.querySelectorAll<HTMLElement>('[data-dl-format]').forEach((el) => {
      const show = present.has(el.dataset.dlFormat!);
      el.hidden = !show;
      if (show) any = true;
    });
    list.hidden = !any;
  }


  async function main(): Promise<void> {
    const detected = await detect();
    let builds: Build[] | null = null;
    try {
      const res = await fetch(API);
      if (res.ok) {
        const data = await res.json();
        if (Array.isArray(data?.builds)) builds = sortBuilds(data.builds);
      }
    } catch { /* static card already reads correctly without release data */ }
    renderPrimary(detected, builds);
    if (builds) {
      renderGrid(builds);
      renderFormats(builds);
    }
  }

  main();
</script>
